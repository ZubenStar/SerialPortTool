            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#1D222B" />
            <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#40181D26" />

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#181D26" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1D222B" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#262D38" />

            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#262D38" />
