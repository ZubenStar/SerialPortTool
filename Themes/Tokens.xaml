<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Design tokens for the serial-port bench instrument.

        Two layers live in here:

        1. App*-prefixed tokens — the palette/typography/geometry this app's own markup uses.
           Nothing in MainWindow.xaml may hard-code a colour; it references these keys.

        2. Overrides of WinUI's own lightweight-styling keys (ApplicationPageBackgroundThemeBrush,
           TextFillColorPrimaryBrush, TextControl*, ComboBox*, MenuFlyout*, ...). Those exist so the
           stock controls and the pre-existing references in LogListView.xaml adopt the same palette
           WITHOUT re-templating ComboBox/TextBox — re-templating those means re-implementing the
           editable-text ComboBox path (used by the search box) and the caret/selection behaviour,
           which is a large amount of fragile surface for no visual gain.

        Keep the Light/Dark/HighContrast dictionaries key-complete: a key missing from one of them
        falls back to the framework default for that theme and shows up as an inconsistent control.
    -->

    <!-- ==================================================================================
         Typography — exactly two families. Hierarchy is carried by size/weight/tracking,
         never by introducing a third face. Data surfaces are always monospace so columns of
         numbers and port tags stay vertically aligned.
         ================================================================================== -->
    <FontFamily x:Key="AppUiFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Cascadia Mono ships with Win11 / Windows Terminal; Consolas is the Win10 fallback. -->
    <FontFamily x:Key="AppMonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <x:Double x:Key="AppFontSizeCaption">11</x:Double>
    <x:Double x:Key="AppFontSizeBody">13</x:Double>
    <x:Double x:Key="AppFontSizeSubtitle">14</x:Double>
    <x:Double x:Key="AppFontSizeData">13</x:Double>

    <!-- ==================================================================================
         Geometry — 4px base grid. Three control heights: toolbar / form / primary action.

         Radii (v2.5.2): control 6 / card 10 / pill 999. The previous 4/6 pair read as a
         hard-edged instrument panel; the rounder pair is what makes a surface look like a
         card rather than like a box with a border. The framework keys below
         (ControlCornerRadius / OverlayCornerRadius) carry the same values to the stock
         controls that are deliberately NOT re-templated — TextBox, ComboBox, ListViewItem,
         Flyout and ContentDialog — so an input and a button no longer disagree about how
         round a corner is.
         ================================================================================== -->
    <CornerRadius x:Key="AppCornerRadiusControl">6</CornerRadius>
    <CornerRadius x:Key="AppCornerRadiusCard">10</CornerRadius>
    <CornerRadius x:Key="AppCornerRadiusPill">999</CornerRadius>

    <!-- ==================================================================================
         Motion — exactly ONE transitions object, shared by every button-family template in
         Themes/Controls.xaml via {StaticResource}.

         Why a resource instead of an inline <ContentPresenter.BackgroundTransition> per
         template: the system animation preference has to be able to switch it off, and
         Duration is the only knob that needs to move. App.OnLaunched mutates this single
         instance to TimeSpan.Zero when UISettings.AnimationsEnabled is false, and because
         every template holds a reference to this object the guard reaches all of them
         without a second copy of the templates. A per-template instance could not be
         reached from code at all (it lives inside a shared ControlTemplate).
         ================================================================================== -->
    <BrushTransition x:Key="AppHoverTransition" Duration="0:0:0.15" />

    <!-- ==================================================================================
         Depth — the one shadow in the app, and it is deliberately NOT applied by any style.

         Only the surfaces that genuinely float over data reference it (and each one pairs it with
         Translation="0,0,32" at the point of use, because a ThemeShadow with no Z offset draws
         nothing): 命令面板、发送历史、日志空态卡. The section cards that live inside the rail get
         their step from the tonal pair instead — a ThemeShadow is a composition cost for as long as
         its element is alive, and a card that never moves off the working surface does not earn it.
         Declared once because several elements share the same depth; a receiver defaults to the
         elements behind it, which is exactly the intent here.
         ================================================================================== -->
    <ThemeShadow x:Key="AppOverlayShadow" />

    <x:Double x:Key="AppControlHeightCompact">28</x:Double>
    <x:Double x:Key="AppControlHeightForm">32</x:Double>
    <x:Double x:Key="AppControlHeightPrimary">36</x:Double>
    <x:Double x:Key="AppTitleBarHeight">46</x:Double>
    <x:Double x:Key="AppSidebarWidth">272</x:Double>

    <!-- ==================================================================================
         Text styles
         ================================================================================== -->
    <!-- Silkscreen-style section label: small, semi-bold, letter-spaced. -->
    <Style x:Key="AppSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="AppCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ==================================================================================
         Colour tokens
         ================================================================================== -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ============================== LIGHT ("daylight bench") ============================== -->
        <ResourceDictionary x:Key="Light">

            <!-- Framework lightweight key: gives every stock control the 4px instrument radius
                 without re-templating it. -->
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F0F3F7" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceSunkenBrush" Color="#F1F4F8" />
            <SolidColorBrush x:Key="AppHairlineBrush" Color="#E4E8ED" />

            <!-- Raised surface for cards/panels that must read as sitting above the working surface.
                 Light mode has nothing above #FFFFFF, so there the step is carried by the border
                 alone; dark mode lifts the tone instead. Both keys must exist in all three
                 dictionaries — a missing key silently falls back to the framework default.

                 v2.5.2 hangs the section cards on this pair: the rail and the page are painted in
                 AppWindowBackgroundBrush (a cool paper grey) so a white AppCardBackgroundBrush card
                 actually rises off them. Painting the rail with the same white the cards use would
                 make every card invisible in light mode. -->
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#E4E8ED" />

            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#16181C" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#5A626D" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#8A9099" />

            <!-- Accent (v2.5.2): a brighter blue than the old #0F6CBD, which read as navy next to
                 Netcatty's #0088FF. Deliberately NOT that value: white on #0088FF is ~3.3:1, and
                 the send button and the search button carry 11-13px label text. #0B72E7 keeps the
                 lift (and clears 4.5:1 for white) while the hover/pressed steps stay tonal. -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#0B72E7" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#0A63C9" />
            <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#0855AC" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#1A0B72E7" />
            <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="AppControlFillBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppControlFillHoverBrush" Color="#F2F5F9" />
            <SolidColorBrush x:Key="AppControlFillPressedBrush" Color="#E8ECF2" />
            <SolidColorBrush x:Key="AppControlFillDisabledBrush" Color="#F4F5F7" />
            <SolidColorBrush x:Key="AppControlBorderBrush" Color="#D8DDE4" />

            <!-- Hover/pressed washes are a step stronger than before: with a background transition
                 in play the states are read as a movement, and a wash this light was invisible
                 against a card. -->
            <SolidColorBrush x:Key="AppSubtleHoverBrush" Color="#1416181C" />
            <SolidColorBrush x:Key="AppSubtlePressedBrush" Color="#2116181C" />

            <SolidColorBrush x:Key="AppSelectionBrush" Color="#1F0B72E7" />

            <SolidColorBrush x:Key="AppFocusBrush" Color="#16181C" />

            <SolidColorBrush x:Key="AppRxBrush" Color="#0B6E4F" />
            <SolidColorBrush x:Key="AppTxBrush" Color="#8A5A00" />
            <SolidColorBrush x:Key="AppOkBrush" Color="#0B6E4F" />

            <SolidColorBrush x:Key="AppWarnSurfaceBrush" Color="#FFF4CE" />
            <SolidColorBrush x:Key="AppWarnBorderBrush" Color="#F0DCA0" />
            <SolidColorBrush x:Key="AppWarnTextBrush" Color="#5C4405" />
            <SolidColorBrush x:Key="AppWarnIconBrush" Color="#B7791F" />

            <SolidColorBrush x:Key="AppErrorTextBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="AppErrorBorderBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="AppErrorSurfaceBrush" Color="#FDF3F2" />

            <SolidColorBrush x:Key="AppScrollThumbBrush" Color="#33000000" />
            <SolidColorBrush x:Key="AppScrollThumbHoverBrush" Color="#59000000" />

            <!-- Chip (v2.5.2): the small rounded readout the status bar and the title bar use for a
                 single value ("3 个串口", "RX 12.4 KB · TX 1.1 KB"). A neutral fill one step away
                 from the band it sits on plus a hairline, so it reads as a value rather than as
                 another divider. Chips replaced the vertical rules that used to separate these
                 numbers: spacing groups them, and a fill says where one value ends. -->
            <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#EFF2F7" />
            <SolidColorBrush x:Key="AppChipBorderBrush" Color="#E4E8ED" />

            <!-- Port identity palette: it lives in exactly ONE place now —
                 Models/PortColorSlot.cs (PortColorPalette.Slots, which also carries the dark
                 variants and the Chinese display names, and whose slot hexes are the values
                 persisted in settings.json). The ten AppPortColorNBrush resources that used to
                 mirror it here are gone (v2.2.4): the sidebar's colour menu builds its swatches from
                 the palette in MainWindow.PortColorFlyout_Opening. Do not reintroduce a brush per
                 slot — a second copy of a palette is invisible in review and obvious on screen the
                 moment it drifts. -->


            <!-- ==== WinUI lightweight-styling overrides ==== -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F0F3F7" />

            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F0F3F7" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#EAEEF3" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#F1F4F8" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#80FFFFFF" />

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F1F4F8" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E4E8ED" />

            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#E4E8ED" />
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#E4E8ED" />
            <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#E4E8ED" />

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#16181C" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5A626D" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8A9099" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#9AA0A8" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />

            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F2F5F9" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#E8ECF2" />
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#F4F5F7" />
            <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#00000000" />

            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D8DDE4" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#C6CBD3" />
            <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="#14000000" />

            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1416181C" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0F16181C" />
            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00000000" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0B72E7" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0A63C9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0855AC" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#C9DDF6" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#F2F3F5" />
            <SolidColorBrush x:Key="SystemAccentColorBrush2" Color="#0B72E7" />

            <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#16181C" />
            <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#FFFFFF" />

            <!-- Text input -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F7F9FC" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#F4F5F7" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D8DDE4" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#B9C0CA" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0B72E7" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#E4E7EA" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#16181C" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#16181C" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#16181C" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#9AA0A8" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A9099" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#7A818A" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8A9099" />
            <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#1416181C" />
            <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#2116181C" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#800B72E7" />

            <!-- ComboBox (the search box is an editable ComboBox — keep its stock template) -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F7F9FC" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#F2F5F9" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#F4F5F7" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D8DDE4" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#B9C0CA" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#B9C0CA" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#E4E7EA" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#16181C" />
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#16181C" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#9AA0A8" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#8A9099" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#E4E8ED" />
            <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#16181C" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#1416181C" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#1F0B72E7" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#2E0B72E7" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#16181C" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#16181C" />
            <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#0B72E7" />

            <!-- CheckBox -->
            <SolidColorBrush x:Key="CheckBoxFillColorSecondary" Color="#00000000" />
            <SolidColorBrush x:Key="CheckBoxFillColorTertiary" Color="#00000000" />
            <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#5A626D" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushPointerOver" Color="#0B72E7" />
            <SolidColorBrush x:Key="CheckBoxForeground" Color="#16181C" />
            <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#16181C" />
            <SolidColorBrush x:Key="CheckBoxForegroundDisabled" Color="#9AA0A8" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#0B72E7" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#0A63C9" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#0855AC" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#0B72E7" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />

            <!-- Menu / flyout -->
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#E4E8ED" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="#00000000" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#1416181C" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#2116181C" />
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#16181C" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#16181C" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#9AA0A8" />
            <SolidColorBrush x:Key="MenuFlyoutSeparatorBrush" Color="#E4E8ED" />
            <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#8A9099" />

            <!-- ToolTip -->
            <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#E4E8ED" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="#16181C" />

            <!-- ScrollBar: thin, low-contrast until hovered -->
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#33000000" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#59000000" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#73000000" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#33000000" />

            <!-- List selection (the log list paints its own template; these reach the sidebar lists) -->
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1416181C" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1F0B72E7" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#2E0B72E7" />
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#16181C" />

            <!-- Dialog -->
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#E4E8ED" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#E4E8ED" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#4D000000" />

            <SolidColorBrush x:Key="ProgressBarForeground" Color="#0B72E7" />
            <SolidColorBrush x:Key="ProgressBarBackground" Color="#E4E8ED" />
        </ResourceDictionary>

        <!-- ============================== DARK ("bench graphite") ============================== -->
        <ResourceDictionary x:Key="Dark">

            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#0F1219" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#181D26" />
            <SolidColorBrush x:Key="AppSurfaceSunkenBrush" Color="#0F131A" />
            <SolidColorBrush x:Key="AppHairlineBrush" Color="#262D38" />

            <!-- Raised surface — one tonal step above AppSurfaceBrush (see the Light dictionary). -->
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#1D222B" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#2C333F" />

            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#E7EAEE" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#8C95A0" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#6B747F" />

            <!-- Accent (v2.5.2): nudged from #4CC2FF to the hue Netcatty's dark palette uses. The
                 dark accent is already light enough for #0B1014 text on it, so this is a hue move
                 only — no contrast decision is attached to it. -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#3EC1FF" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#63CCFF" />
            <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#31ACEC" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#2E3EC1FF" />
            <SolidColorBrush x:Key="AppOnAccentBrush" Color="#0B1014" />

            <SolidColorBrush x:Key="AppControlFillBrush" Color="#222833" />
