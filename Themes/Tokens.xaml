            <SolidColorBrush x:Key="AppControlFillPressedBrush" Color="#1C222B" />
            <SolidColorBrush x:Key="AppControlFillDisabledBrush" Color="#1A1F27" />
            <SolidColorBrush x:Key="AppControlBorderBrush" Color="#303744" />

            <SolidColorBrush x:Key="AppSubtleHoverBrush" Color="#1FE7EAEE" />
            <SolidColorBrush x:Key="AppSubtlePressedBrush" Color="#2BE7EAEE" />

            <SolidColorBrush x:Key="AppSelectionBrush" Color="#333EC1FF" />

            <SolidColorBrush x:Key="AppFocusBrush" Color="#E7EAEE" />

            <SolidColorBrush x:Key="AppRxBrush" Color="#3DDC97" />
            <SolidColorBrush x:Key="AppTxBrush" Color="#E8A33D" />
            <SolidColorBrush x:Key="AppOkBrush" Color="#3DDC97" />

            <SolidColorBrush x:Key="AppWarnSurfaceBrush" Color="#2B2410" />
            <SolidColorBrush x:Key="AppWarnBorderBrush" Color="#4A3D18" />
            <SolidColorBrush x:Key="AppWarnTextBrush" Color="#F2D98C" />
            <SolidColorBrush x:Key="AppWarnIconBrush" Color="#E8A33D" />

            <SolidColorBrush x:Key="AppErrorTextBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="AppErrorBorderBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="AppErrorSurfaceBrush" Color="#2A1618" />

            <SolidColorBrush x:Key="AppScrollThumbBrush" Color="#40E7EAEE" />
            <SolidColorBrush x:Key="AppScrollThumbHoverBrush" Color="#66E7EAEE" />

            <!-- Chip (v2.5.2) — see the Light dictionary. -->
            <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#222833" />
            <SolidColorBrush x:Key="AppChipBorderBrush" Color="#2C333F" />

            <!-- Port identity palette: see the Light dictionary's note — it lives in
                 Models/PortColorSlot.cs, not here. The dark variants of all ten slots (lifted and
                 slightly desaturated so they stay legible on #0F1219) are carried there too, which
                 is what makes a single Resolve(hex, isDark) call the only rendering path. -->


            <!-- ==== WinUI lightweight-styling overrides ==== -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0F1219" />

            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0F1219" />
