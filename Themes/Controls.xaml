<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Control styles that need more than colour overrides.

        Anything that the stock WinUI template can express through the lightweight-styling keys is
        done in Themes/Tokens.xaml instead (ControlFillColor*, ControlStrokeColor*, AccentFillColor*,
        TextControl*, ComboBox*, MenuFlyout*, ControlCornerRadius, ...). Re-templating a control whose
        template carries real behaviour (ComboBox with IsEditable, ScrollBar, ListViewItem) is
        deliberately avoided — see the note at the top of Tokens.xaml.

        What is left here is the button family (a quiet icon button, a 1px press sink) plus the
        card/chip silhouettes.

        Two rules apply to every template below (v2.5.2):

        * BackgroundTransition="{StaticResource AppHoverTransition}" — the one shared transitions
          object Tokens.xaml defines, so a hover or a press fades instead of snapping. It is a
          resource rather than an inline value because App.OnLaunched has to be able to zero its
          duration when the system animation preference is off; a per-template instance would be
          unreachable from code.

        * VisualState.Setters only ever touch Background / BorderBrush / Opacity. Translation,
          Scale and Rotation are composition-backed and cannot be resolved as a Setter target — a
          setter naming one of them compiles, loads, and then throws the first time the state is
          entered (see the "WinUI 3 避坑约定" table in AGENTS.md).
    -->

    <!-- =============================== Text button =============================== -->
    <ControlTemplate x:Key="AppButtonTemplate" TargetType="Button">
        <ContentPresenter
            x:Name="Presenter"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            ContentTransitions="{TemplateBinding ContentTransitions}"
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
            BackgroundTransition="{StaticResource AppHoverTransition}"
            AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppControlFillHoverBrush}" />
                            <Setter Target="Presenter.BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppControlFillPressedBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppControlFillDisabledBrush}" />
                            <Setter Target="Presenter.Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <!-- Keyboard focus is the accent edge on the presenter that already exists: no extra
                     element, no thickness change (which would move the label by a pixel when the
                     ring appears). PointerFocused is declared but left empty on purpose — a click
                     should not leave a ring behind. -->
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="Presenter.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </ContentPresenter>
    </ControlTemplate>

    <Style x:Key="AppButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeightForm}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
        <Setter Property="Background" Value="{ThemeResource AppControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource AppButtonTemplate}" />
    </Style>

    <!-- Compact height for the unified toolbar. -->
    <Style x:Key="AppToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeightCompact}" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeCaption}" />
    </Style>

    <!-- =============================== Icon button =============================== -->
    <!-- Quiet square button: transparent until hovered. Used for the toolbar actions, per-row port
         close, and the sidebar toggle. Icon-only buttons always carry a tooltip. -->
    <ControlTemplate x:Key="AppIconButtonTemplate" TargetType="Button">
        <ContentPresenter
            x:Name="Presenter"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="{TemplateBinding CornerRadius}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            BackgroundTransition="{StaticResource AppHoverTransition}"
            AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppSubtleHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppSubtlePressedBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="Presenter.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </ContentPresenter>
    </ControlTemplate>

    <Style x:Key="AppIconButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppUiFontFamily}" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource AppIconButtonTemplate}" />
    </Style>

    <Style x:Key="AppToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AppIconButtonStyle}">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="5" />
    </Style>

    <!-- =============================== Accent button =============================== -->
    <!-- Overrides the framework key on purpose: ContentDialog's primary button resolves
         AccentButtonStyle, so dialogs stay visually consistent with the toolbar. -->
    <ControlTemplate x:Key="AppAccentButtonTemplate" TargetType="Button">
        <ContentPresenter
            x:Name="Presenter"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            ContentTransitions="{TemplateBinding ContentTransitions}"
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
            BackgroundTransition="{StaticResource AppHoverTransition}"
            AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppAccentHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppAccentPressedBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppControlFillDisabledBrush}" />
                            <Setter Target="Presenter.Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <!-- The ring has to come from the on-accent colour: a border in the accent would be
                     invisible against the accent fill. -->
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="Presenter.BorderBrush" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </ContentPresenter>
    </ControlTemplate>

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppOnAccentBrush}" />
        <Setter Property="Template" Value="{StaticResource AppAccentButtonTemplate}" />
    </Style>

    <!-- =============================== Toggle button =============================== -->
    <!-- Compact pill used for the search mode switches (Aa / .*). Unchecked is deliberately quiet
         (outlined, secondary text); Checked fills with the accent so the active mode is obvious at a
         glance. CheckStates is declared after CommonStates on purpose: the later group wins for a
         property both groups set, which is what keeps the accent fill stable while hovering a
         checked toggle. -->
    <ControlTemplate x:Key="AppToggleButtonTemplate" TargetType="ToggleButton">
        <ContentPresenter
            x:Name="Presenter"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            Foreground="{TemplateBinding Foreground}"
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
            BackgroundTransition="{StaticResource AppHoverTransition}"
            AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppSubtleHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppSubtlePressedBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Unchecked" />
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppAccentSubtleBrush}" />
                            <Setter Target="Presenter.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                            <Setter Target="Presenter.Foreground" Value="{ThemeResource AppAccentBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
                <!-- Declared after CheckStates on purpose: the later group wins for a property both
                     set, so a focused-and-checked switch shows the strong text-coloured ring rather
                     than the accent edge it already has while checked. -->
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="Presenter.BorderBrush" Value="{ThemeResource AppTextPrimaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </ContentPresenter>
    </ControlTemplate>

    <Style x:Key="AppToolbarToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource AppUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeightCompact}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource AppToggleButtonTemplate}" />
    </Style>

    <!-- =============================== Misc =============================== -->
    <!-- Search-history row: a full-width, chrome-free button so the whole line is the click target
         while the per-row delete button next to it stays a separate hit area. -->
    <Style x:Key="AppHistoryItemButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeightCompact}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- Hairline vertical rule used between toolbar groups. -->
    <Style x:Key="AppVerticalDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{ThemeResource AppHairlineBrush}" />
        <Setter Property="Margin" Value="4,6" />
    </Style>

    <!-- =============================== Card / panel skeleton =============================== -->
    <!-- The shared "panel" silhouette: raised surface, soft edge, card radius. A section is
         labelled with AppSectionLabelStyle (Themes/Tokens.xaml); this is what an element that has to
         read as floating above the working surface uses.

         Depth policy (v2.5.2): the cards that live in the configuration rail, the toolbar and the
         send row express their step with the tonal pair (AppCardBackgroundBrush over the page's
         AppWindowBackgroundBrush) plus a soft border — they are permanent residents, and a
         ThemeShadow is a composition cost paid for as long as its element is alive. The surfaces
         that genuinely float over the data (命令面板 / 发送历史 / 日志空态卡) add
         Shadow="{StaticResource AppOverlayShadow}" + Translation="0,0,32" at the point of use,
         which is where the depth actually means something. High contrast collapses both keys onto
         the system colours. -->
    <Style x:Key="AppCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusCard}" />
        <Setter Property="Padding" Value="24,20" />
    </Style>

    <!-- Rail section card: same silhouette, tighter padding — the rail is 272 px wide and a 24 px
         inset there costs the content a fifth of its usable width. -->
    <Style x:Key="AppSectionCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Inset group: a block *inside* a card (the rail's 自动化 switches, the send-settings
         flyout's option groups). A card inside a card reads as a mistake, so the nested block drops
         a level instead: sunken fill, control radius, same border family. -->
    <Style x:Key="AppInsetGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- Card header: the title row inside a section card. One step stronger than
         AppSectionLabelStyle, which stays the small letter-spaced label used for groups *inside* a
         card (自动化, 发送选项, …). -->
    <Style x:Key="AppCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- =============================== Chip =============================== -->
    <!-- One value in a rounded capsule ("3 个串口", "RX 12.4 KB · TX 1.1 KB"). Chips replaced the
         vertical rules that used to separate the status-bar readouts: a rule says "these are
         different things", a capsule says "this is one value", and the numbers used to read as one
         run-on line. Pill radius, so the shape is unmistakable at ~20 px tall. -->
    <Style x:Key="AppChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppChipBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppChipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusPill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Segmented group: the capsule that holds a run of related icon buttons (the log toolbar's
         全选 / 复制 / 导出 / 清空). The band behind them is what turns four separate hover targets
         into one visible cluster — the buttons keep their own hover wash inside it, so nothing about
         their hit area or their states changes. -->
    <Style x:Key="AppSegmentedGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusPill}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- =============================== Empty state =============================== -->
    <Style x:Key="AppEmptyStateTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppEmptyStateBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
