<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Control styles that need more than colour overrides.

        Anything that the stock WinUI template can express through the lightweight-styling keys is
        done in Themes/Tokens.xaml instead (ControlFillColor*, ControlStrokeColor*, AccentFillColor*,
        TextControl*, ComboBox*, MenuFlyout*, ControlCornerRadius, ...). Re-templating a control whose
        template carries real behaviour (ComboBox with IsEditable, ScrollBar, ListViewItem) is
        deliberately avoided — see the note at the top of Tokens.xaml.

        What is left here is the button family, where the stock template has no notion of the
        compact instrument silhouettes we want (a quiet icon button, a 1px press sink).
    -->

    <!-- =============================== Text button =============================== -->
    <ControlTemplate x:Key="AppButtonTemplate" TargetType="Button">
        <ContentPresenter
            x:Name="Presenter"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            ContentTransitions="{TemplateBinding ContentTransitions}"
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
            AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppControlFillHoverBrush}" />
                            <Setter Target="Presenter.BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppControlFillPressedBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppControlFillDisabledBrush}" />
                            <Setter Target="Presenter.Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </ContentPresenter>
    </ControlTemplate>

    <Style x:Key="AppButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeightForm}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
        <Setter Property="Background" Value="{ThemeResource AppControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource AppButtonTemplate}" />
    </Style>

    <!-- Compact height for the unified toolbar. -->
    <Style x:Key="AppToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeightCompact}" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeCaption}" />
    </Style>

    <!-- =============================== Icon button =============================== -->
    <!-- Quiet square button: transparent until hovered. Used for the toolbar actions, per-row port
         close, and the sidebar toggle. Icon-only buttons always carry a tooltip. -->
    <ControlTemplate x:Key="AppIconButtonTemplate" TargetType="Button">
        <ContentPresenter
            x:Name="Presenter"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="{TemplateBinding CornerRadius}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppSubtleHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppSubtlePressedBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </ContentPresenter>
    </ControlTemplate>

    <Style x:Key="AppIconButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppUiFontFamily}" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource AppIconButtonTemplate}" />
    </Style>

    <Style x:Key="AppToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AppIconButtonStyle}">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="5" />
    </Style>

    <!-- =============================== Accent button =============================== -->
    <!-- Overrides the framework key on purpose: ContentDialog's primary button resolves
         AccentButtonStyle, so dialogs stay visually consistent with the toolbar. -->
    <ControlTemplate x:Key="AppAccentButtonTemplate" TargetType="Button">
        <ContentPresenter
            x:Name="Presenter"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            ContentTransitions="{TemplateBinding ContentTransitions}"
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
            AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppAccentHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppAccentPressedBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppControlFillDisabledBrush}" />
                            <Setter Target="Presenter.Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </ContentPresenter>
    </ControlTemplate>

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppOnAccentBrush}" />
        <Setter Property="Template" Value="{StaticResource AppAccentButtonTemplate}" />
    </Style>

    <!-- =============================== Toggle button =============================== -->
    <!-- Compact pill used for the search mode switches (Aa / .*). Unchecked is deliberately quiet
         (outlined, secondary text); Checked fills with the accent so the active mode is obvious at a
         glance. CheckStates is declared after CommonStates on purpose: the later group wins for a
         property both groups set, which is what keeps the accent fill stable while hovering a
         checked toggle. -->
    <ControlTemplate x:Key="AppToggleButtonTemplate" TargetType="ToggleButton">
        <ContentPresenter
            x:Name="Presenter"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            Foreground="{TemplateBinding Foreground}"
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
            AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppSubtleHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppSubtlePressedBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Unchecked" />
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="Presenter.Background" Value="{ThemeResource AppAccentSubtleBrush}" />
                            <Setter Target="Presenter.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                            <Setter Target="Presenter.Foreground" Value="{ThemeResource AppAccentBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </ContentPresenter>
    </ControlTemplate>

    <Style x:Key="AppToolbarToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource AppUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeightCompact}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource AppToggleButtonTemplate}" />
    </Style>

    <!-- =============================== Misc =============================== -->
    <!-- Search-history row: a full-width, chrome-free button so the whole line is the click target
         while the per-row delete button next to it stays a separate hit area. -->
    <Style x:Key="AppHistoryItemButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeightCompact}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- Hairline vertical rule used between toolbar groups. -->
    <Style x:Key="AppVerticalDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{ThemeResource AppHairlineBrush}" />
        <Setter Property="Margin" Value="4,6" />
    </Style>

</ResourceDictionary>
