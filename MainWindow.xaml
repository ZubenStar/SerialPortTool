<Window
    x:Class="SerialPortTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SerialPortTool.Converters"
    xmlns:controls="using:SerialPortTool.Controls"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}">

    <!--
        Layout: bench-instrument faceplate.

        Row 0 is the custom title bar (drag region on Windows 11; on Windows 10 the system title bar
        stays and this band is simply the app's own header). Row 1 is the instrument body: a narrow
        configuration rail plus the working surface, whose vertical order is
        toolbar → channel legend → log → send → status. Only the log row is `*`, so the log always
        absorbs whatever height the window gains.

        Every colour comes from Themes/Tokens.xaml. There are no literal colours in this file on
        purpose: that is what makes the appearance switch (and high contrast) work.
    -->

    <!-- RootLayout carries the ViewModel as its DataContext so that converters can be used at all:
         a compiled {x:Bind} with a Converter needs a FrameworkElement as its converter-lookup root,
         and a WinUI 3 Window is not one. Anything in this file that needs a converter therefore uses
         {Binding} (which resolves through the inherited DataContext), while plain value bindings keep
         using {x:Bind} for compilation. DataTemplates are unaffected - they set their own DataContext
         per item. -->
    <Grid x:Name="RootLayout"
          Background="{ThemeResource AppWindowBackgroundBrush}"
          DataContext="{x:Bind ViewModel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Window-level keyboard shortcuts are NOT declared here. A KeyboardAccelerator on this
             element was tried first and never fired in this application: Ctrl+Shift+L and
             Ctrl+Alt+L both did nothing at all, while the same keys work in every other program.
             The same element was also what made the framework advertise the gesture in a tooltip
             under the pointer anywhere in the UI (an accelerator advertises itself in its owner's
             tooltip by default since Windows 10 1803).

             The gestures are handled by MainWindow.OnRootKeyDown instead - the same KeyDown
             mechanism the log list already uses for Ctrl+C / Ctrl+A - and the 工具 menu item
             carries its own KeyboardAccelerator only so the gesture is visible in the menu. -->


        <!-- ============================= Title bar ============================= -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="{StaticResource AppTitleBarHeight}"
              Padding="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Wordmark. A drawn mark, not a fabricated glyph: the silkscreen on a real faceplate
                 is type, and it keeps the header free of an icon that might not exist on Win10. -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Border Width="3"
                        Height="18"
                        CornerRadius="1.5"
                        Background="{ThemeResource AppAccentBrush}" />
                <TextBlock Text="串口工具"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Menus live in the title bar so the header is a single band, not two stacked bars. -->
            <MenuBar Grid.Column="1"
                     Margin="14,0,0,0"
                     VerticalAlignment="Center"
                     Background="Transparent">
                <MenuBarItem Title="文件">
                    <MenuFlyoutItem Text="退出" Click="Exit_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem Title="工具">
                    <MenuFlyoutItem Text="扫描串口" Command="{x:Bind ViewModel.ScanPortsCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="折叠 / 展开串口配置栏" Click="ToggleSidebar_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE700;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <!-- F9. The window-level trigger is MainWindow.OnRootKeyDown (see the note on
                         the root Grid); this accelerator is here so the menu shows the gesture, and
                         it also makes F9 work while this menu is open. It cannot double-fire with
                         that handler: a flyout is a separate popup root, so its key events never
                         travel through the window's element tree. -->
                    <MenuFlyoutItem Text="打开日志文件夹"
                                    Click="OpenLogFolder_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F9" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <!-- Hidden-by-default feature: the Tuning / TOTA panel only appears when this is
                         ticked, and the choice is persisted (ViewModel.IsTuningEnabled). -->
                    <ToggleMenuFlyoutItem x:Name="TuningEnabledMenuItem"
                                          Text="启用 Tuning 功能"
                                          IsChecked="{x:Bind ViewModel.IsTuningEnabled, Mode=TwoWay}">
                        <ToggleMenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE950;" />
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem Title="外观">
                    <RadioMenuFlyoutItem x:Name="ThemeSystemMenuItem"
                                         Text="跟随系统"
                                         Tag="System"
                                         GroupName="AppTheme"
                                         Click="ThemeMenuItem_Click" />
                    <RadioMenuFlyoutItem x:Name="ThemeLightMenuItem"
                                         Text="浅色"
                                         Tag="Light"
                                         GroupName="AppTheme"
                                         Click="ThemeMenuItem_Click" />
                    <RadioMenuFlyoutItem x:Name="ThemeDarkMenuItem"
                                         Text="深色"
                                         Tag="Dark"
                                         GroupName="AppTheme"
                                         Click="ThemeMenuItem_Click" />
                </MenuBarItem>
                <MenuBarItem Title="帮助">
                    <MenuFlyoutItem Text="检查更新" Click="CheckUpdate_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="关于" Click="About_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>
            </MenuBar>

            <!-- Port overview: identity colours only. Per-port counters live in the channel legend
                 directly above the log, where they are being read anyway. -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">
                <Ellipse Width="7"
                         Height="7"
                         Fill="{ThemeResource AppOkBrush}"
                         Visibility="{Binding HasOpenPorts, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="{x:Bind ViewModel.OpenPortCountDisplay, Mode=OneWay}"
                           Style="{StaticResource AppCaptionTextStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Sidebar toggle + the space the system caption buttons occupy. The spacer's width is
                 assigned from AppWindow.TitleBar.RightInset in code (it is 0 when the title bar is
                 not customised, e.g. on Windows 10). -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                <Button x:Name="SidebarToggleButton"
                        Style="{StaticResource AppToolbarIconButtonStyle}"
                        Click="ToggleSidebar_Click"
                        ToolTipService.ToolTip="折叠 / 展开串口配置栏">
                    <Grid>
                        <FontIcon Glyph="&#xE76B;"
                                  FontSize="14"
                                  Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <FontIcon Glyph="&#xE76C;"
                                  FontSize="14"
                                  Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Button>
                <Border x:Name="TitleBarInsetSpacer" Width="0" />
            </StackPanel>
        </Grid>

        <!-- ============================= Body ============================= -->
        <Grid Grid.Row="1" Background="{ThemeResource AppWindowBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========== Configuration rail ========== -->
            <Border x:Name="SidebarHost"
                    Grid.Column="0"
                    Width="{StaticResource AppSidebarWidth}"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppHairlineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Padding="14,14,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Port parameters -->
                    <StackPanel Grid.Row="0" Spacing="10">
                        <TextBlock Text="串口参数" Style="{StaticResource AppSectionLabelStyle}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="波特率" Style="{StaticResource AppCaptionTextStyle}" />
                            <ComboBox x:Name="BaudRateComboBox"
                                      ItemsSource="{x:Bind ViewModel.AvailableBaudRates}"
                                      SelectedItem="{x:Bind ViewModel.BaudRate, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                            <TextBox x:Name="CustomBaudRateTextBox"
                                     PlaceholderText="自定义波特率"
                                     Text="{x:Bind ViewModel.CustomBaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Stretch"
                                     InputScope="Number"
                                     Visibility="Collapsed" />
                            <CheckBox Content="自定义波特率"
                                      IsChecked="{x:Bind ViewModel.UseCustomBaudRate, Mode=TwoWay}"
                                      Checked="CustomBaudRateCheckBox_Changed"
                                      Unchecked="CustomBaudRateCheckBox_Changed" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="数据位" Style="{StaticResource AppCaptionTextStyle}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.AvailableDataBits}"
                                      SelectedItem="{x:Bind ViewModel.DataBits, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Available ports -->
                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,18,0,0">
                        <TextBlock Text="可用串口" Style="{StaticResource AppSectionLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource AppToolbarButtonStyle}"
                                    Command="{x:Bind ViewModel.ScanPortsCommand}"
                                    ToolTipService.ToolTip="重新扫描可用串口">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="扫描" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource AccentButtonStyle}"
                                    MinHeight="{StaticResource AppControlHeightCompact}"
                                    MinWidth="0"
                                    Padding="10,0"
                                    Margin="6,0,0,0"
                                    Command="{x:Bind ViewModel.OpenAllPortsCommand}"
                                    ToolTipService.ToolTip="以当前参数打开全部可用串口">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                                    <TextBlock Text="全部打开" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView x:Name="PortListView"
                                  ItemsSource="{x:Bind ViewModel.AvailablePorts, Mode=OneWay}"
                                  SelectionMode="Single"
                                  MaxHeight="168"
                                  SelectionChanged="PortListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}"
                                               FontFamily="{StaticResource AppMonoFontFamily}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- Open ports -->
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="已打开串口"
                                       Style="{StaticResource AppSectionLabelStyle}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource AppToolbarIconButtonStyle}"
                                    Content="&#xE8BB;"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="12"
                                    Command="{x:Bind ViewModel.CloseAllPortsCommand}"
                                    ToolTipService.ToolTip="关闭所有串口" />
                        </Grid>

                        <ListView x:Name="OpenPortListView"
                                  Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.OpenPorts, Mode=OneWay}"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Colour picker for this port. A DropDownButton keeps the
                                             chevron affordance and its stock template already follows
                                             the new palette through the lightweight styling keys. -->
                                        <DropDownButton Grid.Column="0"
                                                        Margin="0,0,8,0"
                                                        Padding="3"
                                                        VerticalAlignment="Center"
                                                        ToolTipService.ToolTip="选择端口颜色">
                                            <Border Width="14"
                                                    Height="14"
                                                    CornerRadius="3"
                                                    Background="{Binding DisplayColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
                                            <DropDownButton.Flyout>
                                                <MenuFlyout Placement="Bottom" Opening="PortColorFlyout_Opening">
                                                    <MenuFlyoutItem Click="PortColorMenuItem_Click" Tag="#107C10"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91F;" Foreground="{ThemeResource AppPortColor1Brush}" /></MenuFlyoutItem.Icon>绿色</MenuFlyoutItem>
                                                    <MenuFlyoutItem Click="PortColorMenuItem_Click" Tag="#0078D4"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91F;" Foreground="{ThemeResource AppPortColor2Brush}" /></MenuFlyoutItem.Icon>蓝色</MenuFlyoutItem>
                                                    <MenuFlyoutItem Click="PortColorMenuItem_Click" Tag="#E74856"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91F;" Foreground="{ThemeResource AppPortColor3Brush}" /></MenuFlyoutItem.Icon>红色</MenuFlyoutItem>
                                                    <MenuFlyoutItem Click="PortColorMenuItem_Click" Tag="#FF8C00"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91F;" Foreground="{ThemeResource AppPortColor4Brush}" /></MenuFlyoutItem.Icon>橙色</MenuFlyoutItem>
                                                    <MenuFlyoutItem Click="PortColorMenuItem_Click" Tag="#881798"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91F;" Foreground="{ThemeResource AppPortColor5Brush}" /></MenuFlyoutItem.Icon>紫色</MenuFlyoutItem>
                                                    <MenuFlyoutItem Click="PortColorMenuItem_Click" Tag="#00B7C3"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91F;" Foreground="{ThemeResource AppPortColor6Brush}" /></MenuFlyoutItem.Icon>青色</MenuFlyoutItem>
                                                    <MenuFlyoutItem Click="PortColorMenuItem_Click" Tag="#C239B3"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91F;" Foreground="{ThemeResource AppPortColor7Brush}" /></MenuFlyoutItem.Icon>粉色</MenuFlyoutItem>
                                                    <MenuFlyoutItem Click="PortColorMenuItem_Click" Tag="#498205"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91F;" Foreground="{ThemeResource AppPortColor8Brush}" /></MenuFlyoutItem.Icon>橄榄绿</MenuFlyoutItem>
                                                    <MenuFlyoutItem Click="PortColorMenuItem_Click" Tag="#8764B8"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91F;" Foreground="{ThemeResource AppPortColor9Brush}" /></MenuFlyoutItem.Icon>淡紫</MenuFlyoutItem>
                                                    <MenuFlyoutItem Click="PortColorMenuItem_Click" Tag="#CA5010"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91F;" Foreground="{ThemeResource AppPortColor10Brush}" /></MenuFlyoutItem.Icon>棕橙</MenuFlyoutItem>
                                                </MenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PortName}"
                                                       FontFamily="{StaticResource AppMonoFontFamily}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatisticsDisplay, Mode=OneWay}"
                                                       Style="{StaticResource AppCaptionTextStyle}"
                                                       FontFamily="{StaticResource AppMonoFontFamily}" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource AppToolbarIconButtonStyle}"
                                                Content="&#xE8BB;"
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Click="ClosePort_Click"
                                                Tag="{Binding PortName}"
                                                ToolTipService.ToolTip="关闭此串口" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <!-- ========== Working surface ========== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Baud-rate mismatch alert: present only when it has something to say -->
                <Border x:Name="BaudRateAlertBorder"
                        Grid.Row="0"
                        Background="{ThemeResource AppWarnSurfaceBrush}"
                        BorderBrush="{ThemeResource AppWarnBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AppCornerRadiusControl}"
                        Padding="12,8"
                        Margin="12,10,12,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE7BA;"
                                  FontSize="15"
                                  Foreground="{ThemeResource AppWarnIconBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="BaudRateAlertTitle"
                                       Text="检测到波特率可能不匹配"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppWarnTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="BaudRateAlertMessage"
                                       Text="建议切换到正确的波特率以获得更好的数据质量"
                                       FontSize="12"
                                       Foreground="{ThemeResource AppWarnTextBrush}"
                                       Opacity="0.85"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Button x:Name="AutoFixBaudRateButton"
                                    Content="自动修复"
                                    Style="{StaticResource AccentButtonStyle}"
                                    MinHeight="{StaticResource AppControlHeightCompact}"
                                    MinWidth="0"
                                    Padding="12,0"
                                    Click="AutoFixBaudRate_Click" />
                            <Button x:Name="DismissAlertButton"
                                    Content="忽略"
                                    Style="{StaticResource AppToolbarButtonStyle}"
                                    Click="DismissAlert_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ========== Unified toolbar ========== -->
                <Border Grid.Row="1"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppHairlineBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 1: search + log actions -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <!-- Wide enough for the text box plus 搜索 / Aa / .* / 历史 / 清空 so a
                                     narrow window shrinks the box, never the buttons. -->
                                <ColumnDefinition Width="*" MinWidth="300" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- The box only carries the draft. Nothing filters until the query is
                                     committed, so a half-typed pattern (or a stray "(" ) can neither
                                     blank the log out nor rebuild it on every keystroke.
                                     UpdateSourceTrigger=PropertyChanged keeps the draft one step ahead
                                     of the Enter key / 搜索 button that commits it. -->
                                <TextBox x:Name="SearchBox"
                                         Grid.Column="0"
                                         MinWidth="80"
                                         MinHeight="{StaticResource AppControlHeightCompact}"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                                         Text="{x:Bind ViewModel.SearchDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="SearchBox_KeyDown"
                                         HorizontalAlignment="Stretch" />

                                <Button Grid.Column="1"
                                        x:Name="ExecuteSearchButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        MinHeight="{StaticResource AppControlHeightCompact}"
                                        MinWidth="52"
                                        Padding="12,0"
                                        Margin="6,0,0,0"
                                        Content="搜索"
                                        Click="ExecuteSearch_Click"
                                        ToolTipService.ToolTip="执行搜索 (Enter)" />

                                <!-- Mode switches. IsChecked is bool? while the ViewModel exposes bool, so
                                     these use {Binding} (which converts) instead of {x:Bind}. -->
                                <ToggleButton Grid.Column="2"
                                              x:Name="CaseSensitiveToggle"
                                              Style="{StaticResource AppToolbarToggleButtonStyle}"
                                              Content="Aa"
                                              Margin="6,0,0,0"
                                              IsChecked="{Binding IsCaseSensitiveSearch, Mode=TwoWay}"
                                              ToolTipService.ToolTip="区分大小写" />

                                <ToggleButton Grid.Column="3"
                                              x:Name="RegexToggle"
                                              Style="{StaticResource AppToolbarToggleButtonStyle}"
                                              Content=".*"
                                              Margin="4,0,0,0"
                                              IsChecked="{Binding IsRegexSearch, Mode=TwoWay}"
                                              ToolTipService.ToolTip="按正则表达式匹配" />

                                <!-- History sits behind an explicit button: typing opens nothing. -->
                                <Button Grid.Column="4"
                                        x:Name="SearchHistoryButton"
                                        Style="{StaticResource AppToolbarIconButtonStyle}"
                                        Margin="6,0,0,0"
                                        ToolTipService.ToolTip="搜索历史">
                                    <FontIcon Glyph="&#xE81C;" FontSize="13" />
                                    <Button.Flyout>
                                        <Flyout x:Name="SearchHistoryFlyout" Placement="Bottom">
                                            <StackPanel Width="300" Spacing="4">
                                                <ListView x:Name="SearchHistoryList"
                                                          ItemsSource="{x:Bind ViewModel.RecentSearchTexts, Mode=OneWay}"
                                                          SelectionMode="None"
                                                          MaxHeight="220">
                                                    <!-- Stretch so each row's delete button sits at the
                                                         right edge instead of hugging the text. -->
                                                    <ListView.ItemContainerStyle>
                                                        <Style TargetType="ListViewItem">
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        </Style>
                                                    </ListView.ItemContainerStyle>
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0"
                                                                        Style="{StaticResource AppHistoryItemButtonStyle}"
                                                                        Content="{x:Bind}"
                                                                        Tag="{x:Bind}"
                                                                        Click="ApplyRecentSearch_Click"
                                                                        ToolTipService.ToolTip="{x:Bind}" />
                                                                <Button Grid.Column="1"
                                                                        Style="{StaticResource AppToolbarIconButtonStyle}"
                                                                        Content="&#xE74D;"
                                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                        FontSize="12"
                                                                        Click="DeleteSearchHistory_Click"
                                                                        Tag="{x:Bind}"
                                                                        ToolTipService.ToolTip="删除此历史记录" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                <TextBlock Text="暂无搜索历史"
                                                           Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                           FontSize="{StaticResource AppFontSizeCaption}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8"
                                                           Visibility="{Binding HasRecentSearches, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                <Border Style="{StaticResource AppVerticalDividerStyle}" />
                                                <Button Style="{StaticResource AppToolbarButtonStyle}"
                                                        HorizontalAlignment="Stretch"
                                                        Content="清空历史"
                                                        Click="ClearSearchHistory_Click"
                                                        IsEnabled="{Binding HasRecentSearches}" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <Button Grid.Column="5"
                                        x:Name="ClearSearchTextButton"
                                        Style="{StaticResource AppToolbarIconButtonStyle}"
                                        Content="&#xE711;"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="11"
                                        Margin="4,0,0,0"
                                        Click="ClearSearchText_Click"
                                        ToolTipService.ToolTip="清空当前搜索"
                                        Visibility="{Binding CanClearSearch, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>

                            <!-- Regex diagnostics sit next to the box they describe -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <FontIcon x:Name="RegexErrorIcon"
                                          Glyph="&#xE7BA;"
                                          FontSize="12"
                                          Foreground="{ThemeResource AppErrorTextBrush}"
                                          Visibility="Collapsed" />
                                <TextBlock x:Name="RegexErrorTextBlock"
                                           Foreground="{ThemeResource AppErrorTextBrush}"
                                           FontSize="12"
                                           MaxWidth="320"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="MatchCountTextBlock"
                                           Style="{StaticResource AppCaptionTextStyle}"
                                           FontFamily="{StaticResource AppMonoFontFamily}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Log actions: quiet icon buttons, one accent-free cluster -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource AppToolbarIconButtonStyle}"
                                        Click="SelectAllLogs_Click"
                                        ToolTipService.ToolTip="全选日志 (Ctrl+A)">
                                    <FontIcon Glyph="&#xE8B3;" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource AppToolbarIconButtonStyle}"
                                        Click="CopySelectedLogs_Click"
                                        ToolTipService.ToolTip="复制选中日志 (Ctrl+C)">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource AppToolbarIconButtonStyle}"
                                        Command="{x:Bind ViewModel.ClearLogsCommand}"
                                        ToolTipService.ToolTip="清空所有日志记录">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                </Button>
                                <Border Style="{StaticResource AppVerticalDividerStyle}" />
                                <Button Style="{StaticResource AppToolbarButtonStyle}"
                                        Click="TogglePause_Click"
                                        ToolTipService.ToolTip="暂停时停止刷新 UI，文件日志继续记录">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Grid>
                                            <FontIcon Glyph="&#xE769;"
                                                      FontSize="13"
                                                      Visibility="{Binding IsPaused, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <FontIcon Glyph="&#xE768;"
                                                      FontSize="13"
                                                      Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: tuning payload + protocol. Hidden by default — the whole row is
                             collapsed until 工具 → 启用 Tuning 功能 is ticked, so an Auto row simply
                             collapses to zero height and leaves the toolbar single-line. -->
                        <Grid Grid.Row="1"
                              Margin="0,8,0,0"
                              Visibility="{Binding IsTuningEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0">
                                <FontIcon Glyph="&#xE950;"
                                          FontSize="13"
                                          Foreground="{ThemeResource AppAccentBrush}" />
                                <TextBlock Text="TUNING"
                                           Style="{StaticResource AppSectionLabelStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- File slots: a chip shows the file name, the full path is the tooltip.
                                 Placeholder and value are two TextBlocks rather than a converter. -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource AppToolbarButtonStyle}"
                                    Padding="9,0"
                                    MinWidth="0"
                                    HorizontalAlignment="Left"
                                    Click="SelectTuningBin_Click"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.TuningBinFilePath, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="13" />
                                    <TextBlock Text="未选择 bin 文件"
                                               Foreground="{ThemeResource AppTextTertiaryBrush}"
                                               Visibility="{Binding HasTuningBinFilePath, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.TuningBinDisplay, Mode=OneWay}"
                                               Visibility="{Binding HasTuningBinFilePath, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Style="{StaticResource AppToolbarButtonStyle}"
                                    Padding="9,0"
                                    MinWidth="0"
                                    Margin="6,0,0,0"
                                    HorizontalAlignment="Left"
                                    Click="SelectTuningDescriptor_Click"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.TuningDescriptorFilePath, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="13" />
                                    <TextBlock Text="未选择协议 JSON"
                                               Foreground="{ThemeResource AppTextTertiaryBrush}"
                                               Visibility="{Binding HasTuningDescriptorPath, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.TuningDescriptorDisplay, Mode=OneWay}"
                                               Visibility="{Binding HasTuningDescriptorPath, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind ViewModel.TuningStatus, Mode=OneWay}"
                                       Style="{StaticResource AppCaptionTextStyle}"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.TuningStatus, Mode=OneWay}" />

                            <StackPanel Grid.Column="4"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource AppToolbarButtonStyle}"
                                        Content="重载 JSON"
                                        Command="{x:Bind ViewModel.ReloadTuningDescriptorCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasTuningDescriptorPath, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.TuningDescriptorStatus, Mode=OneWay}" />
                                <Button Style="{StaticResource AppToolbarButtonStyle}"
                                        Content="{x:Bind ViewModel.TuningWatchButtonText, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.ToggleTuningWatchCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanUseTuning, Mode=OneWay}" />
                                <Button Style="{StaticResource AccentButtonStyle}"
                                        MinHeight="{StaticResource AppControlHeightCompact}"
                                        MinWidth="0"
                                        Padding="12,0"
                                        Command="{x:Bind ViewModel.SendCurrentTuningCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanUseTuning, Mode=OneWay}"
                                        ToolTipService.ToolTip="手动打包并发送当前 tuning bin">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE724;" FontSize="13" />
                                        <TextBlock Text="发送 Tuning" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========== Channel legend (signature) ==========
                     The colour-to-port mapping, stated explicitly: every colour visible in the log
                     body can be translated back to a physical port without opening the sidebar. -->
                <Border Grid.Row="2"
                        Background="{ThemeResource AppSurfaceSunkenBrush}"
                        BorderBrush="{ThemeResource AppHairlineBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,6"
                        Visibility="{Binding HasOpenPorts, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.OpenPorts, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Rectangle Width="3"
                                                   Height="14"
                                                   RadiusX="1.5"
                                                   RadiusY="1.5"
                                                   Fill="{Binding DisplayColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
                                        <TextBlock Text="{Binding PortName}"
                                                   FontFamily="{StaticResource AppMonoFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StatisticsDisplay, Mode=OneWay}"
                                                   FontFamily="{StaticResource AppMonoFontFamily}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Logs Display - extracted into a UserControl so the DataTemplate can use compiled
                     x:Bind (Window-rooted DataTemplates can't, which is what was bottlenecking
                     wheel-scroll item realization). -->
                <controls:LogListView Grid.Row="3"
                                      x:Name="LogListView"
                                      ItemsSource="{x:Bind ViewModel.DisplayLogs, Mode=OneWay}"
                                      IsPaused="{x:Bind ViewModel.IsPaused, Mode=OneWay}"
                                      CopyCompleted="LogListView_CopyCompleted"
                                      CopyFailed="LogListView_CopyFailed" />

                <!-- ========== Send ========== -->
                <Border Grid.Row="4"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppHairlineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <CheckBox Content="十六进制发送"
                                      IsChecked="{x:Bind ViewModel.SendAsHex, Mode=TwoWay}" />
                            <CheckBox Content="显示发送数据"
                                      IsChecked="{x:Bind ViewModel.ShowSentData, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="TX"
                                           Style="{StaticResource AppCaptionTextStyle}"
                                           FontFamily="{StaticResource AppMonoFontFamily}"
                                           VerticalAlignment="Center"
                                           ToolTipService.ToolTip="发送行的颜色。接收行颜色在左侧已打开串口列表中设置。" />
                                <ComboBox x:Name="TxColorComboBox"
                                          ItemsSource="{x:Bind ViewModel.TxColorOptions}"
                                          SelectedValuePath="Hex"
                                          SelectedValue="{x:Bind ViewModel.TxColorHex, Mode=TwoWay}"
                                          MinHeight="{StaticResource AppControlHeightCompact}"
                                          MinWidth="92">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Rectangle Width="13"
                                                           Height="13"
                                                           RadiusX="3"
                                                           RadiusY="3"
                                                           Fill="{Binding Brush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <TextBox x:Name="SendTextBox"
                                 Grid.Column="1"
                                 Text="{x:Bind ViewModel.SendText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="输入要发送的数据，回车发送…"
                                 KeyDown="SendTextBox_KeyDown"
                                 VerticalAlignment="Center"
                                 MinHeight="{StaticResource AppControlHeightPrimary}" />

                        <Button Grid.Column="2"
                                Style="{StaticResource AccentButtonStyle}"
                                MinHeight="{StaticResource AppControlHeightPrimary}"
                                MinWidth="92"
                                Margin="8,0,0,0"
                                Click="SendButton_Click"
                                ToolTipService.ToolTip="发送到全部已打开串口">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE724;" FontSize="13" />
                                <TextBlock Text="发送" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ========== Status bar ========== -->
                <Border Grid.Row="5"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppHairlineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <Ellipse Width="6"
                                     Height="6"
                                     VerticalAlignment="Center"
                                     Fill="{ThemeResource AppOkBrush}"
                                     Visibility="{Binding HasOpenPorts, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Ellipse Width="6"
                                     Height="6"
                                     VerticalAlignment="Center"
                                     Fill="{ThemeResource AppTextTertiaryBrush}"
                                     Visibility="{Binding HasOpenPorts, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.OpenPortCountDisplay, Mode=OneWay}"
                                       Style="{StaticResource AppCaptionTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource AppVerticalDividerStyle}" />

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind ViewModel.TotalTrafficDisplay, Mode=OneWay}"
                                   FontFamily="{StaticResource AppMonoFontFamily}"
                                   FontSize="11"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   ToolTipService.ToolTip="全部已打开串口的累计接收 / 发送字节数" />

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.MatchCountDisplay, Mode=OneWay}"
                                       FontFamily="{StaticResource AppMonoFontFamily}"
                                       FontSize="11"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Style="{StaticResource AppCaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.AppearanceDisplay, Mode=OneWay}"
                                       Style="{StaticResource AppCaptionTextStyle}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.VersionDisplay, Mode=OneWay}"
                                       Style="{StaticResource AppCaptionTextStyle}"
                                       FontFamily="{StaticResource AppMonoFontFamily}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
