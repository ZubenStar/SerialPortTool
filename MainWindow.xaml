<Window
    x:Class="SerialPortTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SerialPortTool.Converters"
    xmlns:controls="using:SerialPortTool.Controls"
    xmlns:models="using:SerialPortTool.Models"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}">

    <!--
        Layout: bench-instrument faceplate.

        Row 0 is the custom title bar (drag region on Windows 11; on Windows 10 the system title bar
        stays and this band is simply the app's own header). Row 1 is the instrument body: a narrow
        configuration rail plus the working surface, whose vertical order is
        toolbar → channel legend → log → send → status. Only the log row is `*`, so the log always
        absorbs whatever height the window gains.

        Every colour comes from Themes/Tokens.xaml. There are no literal colours in this file on
        purpose: that is what makes the appearance switch (and high contrast) work.
    -->

    <!-- RootLayout carries the ViewModel as its DataContext so that converters can be used at all:
         a compiled {x:Bind} with a Converter needs a FrameworkElement as its converter-lookup root,
         and a WinUI 3 Window is not one. Anything in this file that needs a converter therefore uses
         {Binding} (which resolves through the inherited DataContext), while plain value bindings keep
         using {x:Bind} for compilation. DataTemplates are unaffected - they set their own DataContext
         per item. -->
    <Grid x:Name="RootLayout"
          Background="{ThemeResource AppWindowBackgroundBrush}"
          DataContext="{x:Bind ViewModel}">
        <Grid.Resources>
            <!-- A port picker built in code-behind (the notes dialog) needs an ItemTemplate, because a
                 ComboBox over AvailablePortItem with neither an ItemTemplate nor a DisplayMemberPath falls
                 back to object.ToString. AvailablePortItem.ToString returns the port name, which would
                 happen to work — but relying on that fallback is exactly how a later refactor silently
                 turns this dialog into a column of type names. -->
            <DataTemplate x:Key="PortNameItemTemplate" x:DataType="models:AvailablePortItem">
                <TextBlock Text="{x:Bind PortName, Mode=OneWay}"
                           FontFamily="{StaticResource AppMonoFontFamily}" />
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Window-level keyboard shortcuts are NOT declared here. A KeyboardAccelerator on this
             element was tried first and never fired in this application: Ctrl+Shift+L and
             Ctrl+Alt+L both did nothing at all, while the same keys work in every other program.
             The same element was also what made the framework advertise the gesture in a tooltip
             under the pointer anywhere in the UI (an accelerator advertises itself in its owner's
             tooltip by default since Windows 10 1803).

             The gestures are handled by MainWindow.OnRootKeyDown instead - the same KeyDown
             mechanism the log list already uses for Ctrl+C / Ctrl+A - and the 工具 menu item
             carries its own KeyboardAccelerator only so the gesture is visible in the menu. -->


        <!-- ============================= Title bar ============================= -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="{StaticResource AppTitleBarHeight}"
              Padding="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Wordmark. A drawn mark, not a fabricated glyph: the silkscreen on a real faceplate
                 is type, and it keeps the header free of an icon that might not exist on Win10. -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Border Width="3"
                        Height="18"
                        CornerRadius="1.5"
                        Background="{ThemeResource AppAccentBrush}" />
                <TextBlock Text="串口工具"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Menus live in the title bar so the header is a single band, not two stacked bars. -->
            <MenuBar Grid.Column="1"
                     Margin="14,0,0,0"
                     VerticalAlignment="Center"
                     Background="Transparent">
                <MenuBarItem Title="文件">
                    <MenuFlyoutItem Text="退出" Click="Exit_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem Title="工具">
                    <MenuFlyoutItem Text="扫描串口" Command="{x:Bind ViewModel.ScanPortsCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="折叠 / 展开串口配置栏" Click="ToggleSidebar_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE700;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <!-- F9. The window-level trigger is MainWindow.OnRootKeyDown (see the note on
                         the root Grid); this accelerator is here so the menu shows the gesture, and
                         it also makes F9 work while this menu is open. It cannot double-fire with
                         that handler: a flyout is a separate popup root, so its key events never
                         travel through the window's element tree. -->
                    <MenuFlyoutItem Text="打开日志文件夹"
                                    Click="OpenLogFolder_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F9" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <!-- Hidden-by-default feature: the Tuning / TOTA panel only appears when this is
                         ticked, and the choice is persisted (ViewModel.IsTuningEnabled). -->
                    <ToggleMenuFlyoutItem x:Name="TuningEnabledMenuItem"
                                          Text="启用 Tuning 功能"
                                          IsChecked="{x:Bind ViewModel.IsTuningEnabled, Mode=TwoWay}">
                        <ToggleMenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE950;" />
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem Title="外观">
                    <RadioMenuFlyoutItem x:Name="ThemeSystemMenuItem"
                                         Text="跟随系统"
                                         Tag="System"
                                         GroupName="AppTheme"
                                         Click="ThemeMenuItem_Click" />
                    <RadioMenuFlyoutItem x:Name="ThemeLightMenuItem"
                                         Text="浅色"
                                         Tag="Light"
                                         GroupName="AppTheme"
                                         Click="ThemeMenuItem_Click" />
                    <RadioMenuFlyoutItem x:Name="ThemeDarkMenuItem"
                                         Text="深色"
                                         Tag="Dark"
                                         GroupName="AppTheme"
                                         Click="ThemeMenuItem_Click" />
                    <MenuFlyoutSeparator />
                    <!-- The log font size sits with the appearance entries: it is the same kind of choice, and
                         it is the only other thing in this menu that changes how the data area looks. The
                         accelerators are here so the gestures are visible; the window-level handler is what
                         makes them work everywhere else (see OnRootKeyDown), and the two cannot double-fire
                         because a flyout is a separate popup root. -->
                    <MenuFlyoutSubItem Text="日志字号">
                        <MenuFlyoutItem Text="增大" Click="IncreaseLogFontSize_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Add" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="减小" Click="DecreaseLogFontSize_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Subtract" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="重置" Click="ResetLogFontSize_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number0" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuFlyoutSubItem>
                </MenuBarItem>
                <MenuBarItem Title="帮助">
                    <MenuFlyoutItem Text="检查更新" Click="CheckUpdate_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="关于" Click="About_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>
            </MenuBar>

            <!-- Port overview: identity colours only. Per-port counters live in the channel legend
                 directly above the log, where they are being read anyway. -->
            <Border Grid.Column="2"
                    Style="{StaticResource AppChipStyle}"
                    Margin="14,0,0,0"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="7"
                             Height="7"
                             VerticalAlignment="Center"
                             Fill="{ThemeResource AppOkBrush}"
                             Visibility="{Binding HasOpenPorts, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind ViewModel.OpenPortCountDisplay, Mode=OneWay}"
                               Style="{StaticResource AppChipTextStyle}" />
                </StackPanel>
            </Border>

            <!-- Sidebar toggle + the space the system caption buttons occupy. The spacer's width is
                 assigned from AppWindow.TitleBar.RightInset in code (it is 0 when the title bar is
                 not customised, e.g. on Windows 10). -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                <Button x:Name="SidebarToggleButton"
                        Style="{StaticResource AppToolbarIconButtonStyle}"
                        Click="ToggleSidebar_Click"
                        ToolTipService.ToolTip="折叠 / 展开串口配置栏">
                    <Grid>
                        <FontIcon Glyph="&#xE76B;"
                                  FontSize="14"
                                  Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <FontIcon Glyph="&#xE76C;"
                                  FontSize="14"
                                  Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Button>
                <Border x:Name="TitleBarInsetSpacer" Width="0" />
            </StackPanel>
        </Grid>

        <!-- ============================= Body ============================= -->
        <Grid Grid.Row="1" Background="{ThemeResource AppWindowBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========== Configuration rail ========== -->
            <!-- The rail scrolls as one column. It used to be a plain three-row Grid whose last row was
                 `*`, which meant anything taller than the window was simply cut off — on a short window
                 the 已打开串口 list, the very thing the rail exists for, became unreachable. Wrapping the
                 Grid in a ScrollViewer fixes that: under the infinite height a ScrollViewer measures
                 with, the `*` row resolves exactly like an Auto row, so the open-port list lays itself
                 out at its natural height and the whole column scrolls. The trade is that the open-port
                 list no longer stretches to fill the rail — which is what it has to give up for the list
                 to stay reachable.

                 SidebarHost itself must stay where it is: MainWindow.ApplySidebarWidth animates
                 `SidebarHost.Width` and toggles its Visibility to fold the rail, so moving the x:Name onto
                 the ScrollViewer would animate the wrong element.

                 The rail is painted in AppWindowBackgroundBrush — the *page* colour, not the surface
                 colour (v2.5.2). That is what makes the three section cards rise: a card is
                 AppCardBackgroundBrush, and in light mode that is pure white, so painting the rail
                 white as well would leave every card visible only by its border. The three sections
                 read as one column of cards instead of as three blocks separated by rules. -->
            <Border x:Name="SidebarHost"
                    Grid.Column="0"
                    Width="{StaticResource AppSidebarWidth}"
                    Background="{ThemeResource AppWindowBackgroundBrush}"
                    BorderBrush="{ThemeResource AppHairlineBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid Padding="12,12,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Port parameters. One of the rail's three section cards (v2.5.2): the title row
                         names the block and the card's raised surface is what separates it from its
                         neighbours — the column no longer needs rules between sections. -->
                    <Border Grid.Row="0" Style="{StaticResource AppSectionCardStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE713;"
                                          FontSize="13"
                                          Foreground="{ThemeResource AppTextSecondaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="串口参数" Style="{StaticResource AppCardTitleStyle}" />
                            </StackPanel>

                            <!-- Named presets (F3). Above the individual parameters rather than below: picking a
                                档案 first and then adjusting is the natural order, and the pickers below show
                                what the preset actually set. -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="配置档案" Style="{StaticResource AppCaptionTextStyle}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.PortPresets, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedPortPreset, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          MinHeight="{StaticResource AppControlHeightCompact}"
                                          ToolTipService.ToolTip="保存过的串口参数组合。套用后对新打开的串口生效。">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:PortPreset">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Style="{StaticResource AppToolbarButtonStyle}"
                                            MinHeight="{StaticResource AppControlHeightCompact}"
                                            Padding="9,0"
                                            Content="套用"
                                            Click="ApplyPortPreset_Click"
                                            IsEnabled="{x:Bind ViewModel.HasSelectedPortPreset, Mode=OneWay}"
                                            ToolTipService.ToolTip="把这套档案的参数写回侧栏；已打开的串口不受影响" />
                                    <Button Style="{StaticResource AppToolbarButtonStyle}"
                                            MinHeight="{StaticResource AppControlHeightCompact}"
                                            Padding="9,0"
                                            Content="保存当前"
                                            Click="SavePortPreset_Click"
                                            ToolTipService.ToolTip="把当前参数存成一套档案" />
                                    <Button Style="{StaticResource AppToolbarButtonStyle}"
                                            MinHeight="{StaticResource AppControlHeightCompact}"
                                            Padding="9,0"
                                            Content="删除"
                                            Click="DeletePortPreset_Click"
                                            IsEnabled="{x:Bind ViewModel.HasSelectedPortPreset, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="波特率" Style="{StaticResource AppCaptionTextStyle}" />
                                <ComboBox x:Name="BaudRateComboBox"
                                          ItemsSource="{x:Bind ViewModel.AvailableBaudRates}"
                                          SelectedItem="{x:Bind ViewModel.BaudRate, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                                <TextBox x:Name="CustomBaudRateTextBox"
                                         PlaceholderText="自定义波特率"
                                         Text="{x:Bind ViewModel.CustomBaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalAlignment="Stretch"
                                         InputScope="Number"
                                         Visibility="Collapsed" />
                                <CheckBox Content="自定义波特率"
                                          IsChecked="{x:Bind ViewModel.UseCustomBaudRate, Mode=TwoWay}"
                                          Checked="CustomBaudRateCheckBox_Changed"
                                          Unchecked="CustomBaudRateCheckBox_Changed" />
                            </StackPanel>

                            <!-- ================= Advanced parameters (folded by default) =================
                                 Data bits / stop bits / parity / flow control / encoding are chosen once for a
                                 device and then left alone, yet five stacked pickers plus the automation card
                                 used to own most of the rail's height. They now sit behind one header row, in
                                 the shape the reference client uses: the collapsed header is not a blank
                                 "there are more settings somewhere" strip, it carries the current values as
                                 the classic shorthand (8-N-1, see MainViewModel.LineParametersSummary), so a
                                 folded section reads as a status line rather than as something hidden.

                                 A ToggleButton over a plain Show/Hide panel rather than an Expander: the
                                 Expander's stock header brings its own background/border lightweight-styling
                                 keys, which would be a second control silhouette in a rail whose whole point
                                 is one token set (Themes/Tokens.xaml). AppToolbarToggleButtonStyle already
                                 is the "quiet until active" affordance this needs — and its checked state is
                                 the accent, so "there is no data bits picker visible" always has a visible
                                 reason. -->
                            <ToggleButton x:Name="AdvancedParametersToggle"
                                          Style="{StaticResource AppToolbarToggleButtonStyle}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          MinHeight="{StaticResource AppControlHeightForm}"
                                          Padding="8,0"
                                          IsChecked="{Binding IsAdvancedParametersExpanded, Mode=TwoWay}"
                                          ToolTipService.ToolTip="数据位 / 停止位 / 校验位 / 流控 / 编码与自动化设置。摘要显示的是「下次打开串口」将采用的线路参数；流控与编码只在与默认值不同时才列出。">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="高级参数"
                                                   Style="{StaticResource AppSectionLabelStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.LineParametersSummary, Mode=OneWay}"
                                                   Style="{StaticResource AppCaptionTextStyle}"
                                                   FontFamily="{StaticResource AppMonoFontFamily}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Two glyphs and the two existing converters, the same shape the sidebar
                                         toggle in the title bar uses: one of the two is always collapsed. -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE70D;"
                                                  FontSize="11"
                                                  Visibility="{Binding IsAdvancedParametersExpanded, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        <FontIcon Glyph="&#xE70E;"
                                                  FontSize="11"
                                                  Visibility="{Binding IsAdvancedParametersExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Grid>
                            </ToggleButton>

                            <!-- The 波特率 picker above and the five below are "what the next open uses":
                                 SerialPort applies them when the handle is opened, and applying them to a live
                                 port would mean an implicit close/reopen, which is the race the reliability
                                 rules forbid. Changing one while a port is open therefore only raises a
                                 status-bar hint (MainViewModel.HintThatLineParametersApplyOnNextOpen).

                                 SelectedValue uses {Binding}, not {x:Bind}: the enum is boxed into
                                 ComboBox.SelectedValue (object) and the reflection binding converts it back,
                                 the same reason the search toggles use {Binding} for their bool? target. -->
                            <StackPanel Spacing="10"
                                        Visibility="{Binding IsAdvancedParametersExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="数据位" Style="{StaticResource AppCaptionTextStyle}" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableDataBits}"
                                              SelectedItem="{x:Bind ViewModel.DataBits, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="停止位" Style="{StaticResource AppCaptionTextStyle}" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.StopBitsOptions}"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding StopBits, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="校验位" Style="{StaticResource AppCaptionTextStyle}" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.ParityOptions}"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Parity, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="流控" Style="{StaticResource AppCaptionTextStyle}" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.HandshakeOptions}"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Handshake, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Unlike the other line parameters, the encoding is NOT "next open only": it
                                     is a decode concern, so a change is pushed to every open port immediately
                                     (and each port remembers its own value). Different devices on different
                                     ports genuinely use different character sets, so the per-port value is what
                                     a re-open restores and this control is the default for ports that have none
                                     yet. -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="编码" Style="{StaticResource AppCaptionTextStyle}" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableTextEncodings}"
                                              SelectedItem="{x:Bind ViewModel.TextEncodingName, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              ToolTipService.ToolTip="接收数据的解码方式（也用于文本发送）。对已打开的串口立即生效；每个串口会记住自己的选择。" />
                                </StackPanel>

                                <!-- Automation. Both switches are off by default and stay that way until asked:
                                     restoring ports writes to whatever is plugged in now, and an init sequence
                                     writes commands to a device nobody opened. Economy of surprise says opt in.
                                     It rides with the advanced parameters because it shares their nature —
                                     configured once, then never looked at.

                                     An inset group rather than a card: it now sits *inside* the section card,
                                     and a card inside a card reads as a mistake. -->
                                <Border Style="{StaticResource AppInsetGroupStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="自动化" Style="{StaticResource AppSectionLabelStyle}" />

                                        <CheckBox Content="启动时恢复上次打开的串口"
                                                  IsChecked="{x:Bind ViewModel.RestoreLastPortsOnStartup, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="下次启动时按上次记住的参数重新打开这些串口。串口已拔掉会自动跳过；默认关闭。" />

                                        <CheckBox Content="打开后自动发送初始化序列"
                                                  IsChecked="{x:Bind ViewModel.AutoInitSequenceEnabled, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="端口打开成功后自动发送下面的内容。每次打开只发一次，自动重连不会重发；默认关闭。" />

                                        <TextBox Text="{x:Bind ViewModel.AutoInitSequence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="例如：AT+RESET&#xA;AT+INFO"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MaxHeight="88"
                                                 IsEnabled="{x:Bind ViewModel.AutoInitSequenceEnabled, Mode=OneWay}"
                                                 InputScope="Text"
                                                 ToolTipService.ToolTip="多行内容将逐行发送；支持 ${date} ${time} 等变量与 \\r \\n 转义" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Available ports. The header's count chip is why this block exists at all: an
                         empty list has two very different meanings ("the scan found nothing" vs "no scan
                         has run"), and the header is the only place that can tell them apart. -->
                    <Border Grid.Row="1"
                            Style="{StaticResource AppSectionCardStyle}"
                            Margin="0,12,0,0">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="7">
                                    <FontIcon Glyph="&#xE72C;"
                                              FontSize="13"
                                              Foreground="{ThemeResource AppTextSecondaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="可用串口" Style="{StaticResource AppCardTitleStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource AppChipStyle}">
                                    <TextBlock Text="{x:Bind ViewModel.AvailablePortCountDisplay, Mode=OneWay}"
                                               Style="{StaticResource AppChipTextStyle}" />
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource AppToolbarButtonStyle}"
                                        Command="{x:Bind ViewModel.ScanPortsCommand}"
                                        ToolTipService.ToolTip="重新扫描可用串口">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                        <TextBlock Text="扫描" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Style="{StaticResource AccentButtonStyle}"
                                        MinHeight="{StaticResource AppControlHeightCompact}"
                                        MinWidth="0"
                                        Padding="10,0"
                                        Margin="6,0,0,0"
                                        Command="{x:Bind ViewModel.OpenAllPortsCommand}"
                                        ToolTipService.ToolTip="以当前参数打开全部可用串口">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                                        <TextBlock Text="全部打开" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ListView x:Name="PortListView"
                                      ItemsSource="{x:Bind ViewModel.AvailablePorts, Mode=OneWay}"
                                      SelectionMode="Single"
                                      MaxHeight="220"
                                      SelectionChanged="PortListView_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <!-- Three things a button-sized row can honestly say about a port: which one it
                                         is, what is behind it, and what the user calls it. The second and third
                                         lines are always present as elements and empty as strings when there is
                                         nothing to say — an empty TextBlock occupies no height, so no Visibility
                                         binding is needed and none can get out of step. -->
                                    <DataTemplate x:DataType="models:AvailablePortItem">
                                        <StackPanel Margin="0,2" Spacing="1">
                                            <TextBlock Text="{x:Bind PortName, Mode=OneWay}"
                                                       FontFamily="{StaticResource AppMonoFontFamily}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind DeviceLine, Mode=OneWay}"
                                                       Style="{StaticResource AppCaptionTextStyle}"
                                                       FontFamily="{StaticResource AppMonoFontFamily}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind MetadataLine, Mode=OneWay}"
                                                       Style="{StaticResource AppCaptionTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Notes are edited from here rather than from a button inside the row: clicking
                                 anything inside a ListView item selects that item, and this list's selection IS
                                 "open the port" — a per-row edit button would open a port as a side effect. -->
                            <Button Style="{StaticResource AppToolbarButtonStyle}"
                                    MinHeight="{StaticResource AppControlHeightCompact}"
                                    Click="EditPortNotes_Click"
                                    ToolTipService.ToolTip="给串口写备注、标签或分组，方便下次认出它">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70B;" FontSize="13" />
                                    <TextBlock Text="端口备注" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Open ports. The count chip is bound through {Binding} rather than {x:Bind}: the
                         value is an int and the target is a string, and a reflection binding converts it
                         where a compiled one would need the exact type. -->
                    <Border Grid.Row="2"
                            Style="{StaticResource AppSectionCardStyle}"
                            Margin="0,12,0,0">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="7">
                                    <FontIcon Glyph="&#xE8E5;"
                                              FontSize="13"
                                              Foreground="{ThemeResource AppTextSecondaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="已打开串口" Style="{StaticResource AppCardTitleStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                    <Border Style="{StaticResource AppChipStyle}">
                                        <TextBlock Text="{Binding OpenPortCount}"
                                                   Style="{StaticResource AppChipTextStyle}" />
                                    </Border>
                                    <Button Style="{StaticResource AppToolbarIconButtonStyle}"
                                            Content="&#xE8BB;"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            FontSize="12"
                                            Command="{x:Bind ViewModel.CloseAllPortsCommand}"
                                            ToolTipService.ToolTip="关闭所有串口" />
                                </StackPanel>
                            </Grid>

                            <ListView x:Name="OpenPortListView"
                                      ItemsSource="{x:Bind ViewModel.OpenPorts, Mode=OneWay}"
                                      SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Colour picker for this port. A DropDownButton keeps the
                                                 chevron affordance and its stock template already follows
                                                 the new palette through the lightweight styling keys. -->
                                            <DropDownButton Grid.Column="0"
                                                            Margin="0,0,8,0"
                                                            Padding="3"
                                                            VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="选择端口颜色">
                                                <Border Width="14"
                                                        Height="14"
                                                        CornerRadius="3"
                                                        Background="{Binding DisplayColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
                                                <!-- Empty on purpose: a MenuFlyout has no ItemsSource,
                                                     so the swatches are built from PortColorPalette in
                                                     PortColorFlyout_Opening instead of being declared
                                                     here. Ten hand-written items plus ten
                                                     AppPortColorNBrush resources used to be a second copy
                                                     of the palette that had to be edited in lockstep —
                                                     that duplication is gone (v2.2.4). -->
                                                <DropDownButton.Flyout>
                                                    <MenuFlyout Placement="Bottom" Opening="PortColorFlyout_Opening" />
                                                </DropDownButton.Flyout>
                                            </DropDownButton>

                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PortName}"
                                                           FontFamily="{StaticResource AppMonoFontFamily}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatisticsDisplay, Mode=OneWay}"
                                                           Style="{StaticResource AppCaptionTextStyle}"
                                                           FontFamily="{StaticResource AppMonoFontFamily}" />
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Style="{StaticResource AppToolbarIconButtonStyle}"
                                                    Content="&#xE8BB;"
                                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Click="ClosePort_Click"
                                                    Tag="{Binding PortName}"
                                                    ToolTipService.ToolTip="关闭此串口" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Border>

            <!-- ========== Working surface ========== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Baud-rate mismatch alert: present only when it has something to say -->
                <Border x:Name="BaudRateAlertBorder"
                        Grid.Row="0"
                        Background="{ThemeResource AppWarnSurfaceBrush}"
                        BorderBrush="{ThemeResource AppWarnBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AppCornerRadiusControl}"
                        Padding="12,8"
                        Margin="12,10,12,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE7BA;"
                                  FontSize="15"
                                  Foreground="{ThemeResource AppWarnIconBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="BaudRateAlertTitle"
                                       Text="检测到波特率可能不匹配"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppWarnTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="BaudRateAlertMessage"
                                       Text="建议切换到正确的波特率以获得更好的数据质量"
                                       FontSize="12"
                                       Foreground="{ThemeResource AppWarnTextBrush}"
                                       Opacity="0.85"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Button x:Name="AutoFixBaudRateButton"
                                    Content="自动修复"
                                    Style="{StaticResource AccentButtonStyle}"
                                    MinHeight="{StaticResource AppControlHeightCompact}"
                                    MinWidth="0"
                                    Padding="12,0"
                                    Click="AutoFixBaudRate_Click" />
                            <Button x:Name="DismissAlertButton"
                                    Content="忽略"
                                    Style="{StaticResource AppToolbarButtonStyle}"
                                    Click="DismissAlert_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ========== Unified toolbar ========== -->
                <Border Grid.Row="1"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppHairlineBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 1: search + log actions -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <!-- Wide enough for the text box plus 搜索 / Aa / .* / 历史 / 清空 so a
                                     narrow window shrinks the box, never the buttons. -->
                                <ColumnDefinition Width="*" MinWidth="300" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <!-- 搜索 / Aa / .* / 历史 / 高亮 / 清空 — all Auto so a narrow window
                                     shrinks the box, never the buttons. -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- The box only carries the draft. Nothing filters until the query is
                                     committed, so a half-typed pattern (or a stray "(" ) can neither
                                     blank the log out nor rebuild it on every keystroke.
                                     UpdateSourceTrigger=PropertyChanged keeps the draft one step ahead
                                     of the Enter key / 搜索 button that commits it. -->
                                <TextBox x:Name="SearchBox"
                                         Grid.Column="0"
                                         MinWidth="80"
                                         MinHeight="{StaticResource AppControlHeightCompact}"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                                         Text="{x:Bind ViewModel.SearchDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="SearchBox_KeyDown"
                                         HorizontalAlignment="Stretch" />

                                <Button Grid.Column="1"
                                        x:Name="ExecuteSearchButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        MinHeight="{StaticResource AppControlHeightCompact}"
                                        MinWidth="52"
                                        Padding="12,0"
                                        Margin="6,0,0,0"
                                        Content="搜索"
                                        Click="ExecuteSearch_Click"
                                        ToolTipService.ToolTip="执行搜索 (Enter)" />

                                <!-- Mode switches. IsChecked is bool? while the ViewModel exposes bool, so
                                     these use {Binding} (which converts) instead of {x:Bind}. -->
                                <ToggleButton Grid.Column="2"
                                              x:Name="CaseSensitiveToggle"
                                              Style="{StaticResource AppToolbarToggleButtonStyle}"
                                              Content="Aa"
                                              Margin="6,0,0,0"
                                              IsChecked="{Binding IsCaseSensitiveSearch, Mode=TwoWay}"
                                              ToolTipService.ToolTip="区分大小写" />

                                <ToggleButton Grid.Column="3"
                                              x:Name="RegexToggle"
                                              Style="{StaticResource AppToolbarToggleButtonStyle}"
                                              Content=".*"
                                              Margin="4,0,0,0"
                                              IsChecked="{Binding IsRegexSearch, Mode=TwoWay}"
                                              ToolTipService.ToolTip="按正则表达式匹配" />

                                <!-- History sits behind an explicit button: typing opens nothing. -->
                                <Button Grid.Column="4"
                                        x:Name="SearchHistoryButton"
                                        Style="{StaticResource AppToolbarIconButtonStyle}"
                                        Margin="6,0,0,0"
                                        ToolTipService.ToolTip="搜索历史">
                                    <FontIcon Glyph="&#xE81C;" FontSize="13" />
                                    <Button.Flyout>
                                        <Flyout x:Name="SearchHistoryFlyout" Placement="Bottom">
                                            <StackPanel Width="300" Spacing="4">
                                                <ListView x:Name="SearchHistoryList"
                                                          ItemsSource="{x:Bind ViewModel.RecentSearchTexts, Mode=OneWay}"
                                                          SelectionMode="None"
                                                          MaxHeight="220">
                                                    <!-- Stretch so each row's delete button sits at the
                                                         right edge instead of hugging the text. -->
                                                    <ListView.ItemContainerStyle>
                                                        <Style TargetType="ListViewItem">
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        </Style>
                                                    </ListView.ItemContainerStyle>
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0"
                                                                        Style="{StaticResource AppHistoryItemButtonStyle}"
                                                                        Content="{x:Bind}"
                                                                        Tag="{x:Bind}"
                                                                        Click="ApplyRecentSearch_Click"
                                                                        ToolTipService.ToolTip="{x:Bind}" />
                                                                <Button Grid.Column="1"
                                                                        Style="{StaticResource AppToolbarIconButtonStyle}"
                                                                        Content="&#xE74D;"
                                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                        FontSize="12"
                                                                        Click="DeleteSearchHistory_Click"
                                                                        Tag="{x:Bind}"
                                                                        ToolTipService.ToolTip="删除此历史记录" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                <TextBlock Text="暂无搜索历史"
                                                           Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                           FontSize="{StaticResource AppFontSizeCaption}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8"
                                                           Visibility="{Binding HasRecentSearches, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                <Border Style="{StaticResource AppVerticalDividerStyle}" />
                                                <Button Style="{StaticResource AppToolbarButtonStyle}"
                                                        HorizontalAlignment="Stretch"
                                                        Content="清空历史"
                                                        Click="ClearSearchHistory_Click"
                                                        IsEnabled="{Binding HasRecentSearches}" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <Button Grid.Column="5"
                                        x:Name="ClearSearchTextButton"
                                        Style="{StaticResource AppToolbarIconButtonStyle}"
                                        Content="&#xE711;"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="11"
                                        Margin="4,0,0,0"
                                        Click="ClearSearchText_Click"
                                        ToolTipService.ToolTip="清空当前搜索"
                                        Visibility="{Binding CanClearSearch, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Keyword highlighting sits with the search box: it decorates the same
                                     rows, and it is edited far more often than it is switched. -->
                                <Button Grid.Column="6"
                                        x:Name="HighlightRulesButton"
                                        Style="{StaticResource AppToolbarIconButtonStyle}"
                                        Margin="4,0,0,0"
                                        ToolTipService.ToolTip="关键字高亮规则">
                                    <FontIcon Glyph="&#xE7E6;" FontSize="13" />
                                    <Button.Flyout>
                                        <Flyout x:Name="HighlightRulesFlyout" Placement="Bottom">
                                            <StackPanel Width="360" Spacing="8">
                                                <TextBlock Text="关键字高亮"
                                                           Style="{StaticResource AppSectionLabelStyle}" />

                                                <TextBlock Text="还没有高亮规则。添加后命中的文字会被染色；数据洪水期间会自动暂停，洪峰过去后恢复。"
                                                           Style="{StaticResource AppEmptyStateBodyStyle}"
                                                           Visibility="{Binding HasHighlightRules, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                                <ScrollViewer MaxHeight="240"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{x:Bind ViewModel.HighlightRules, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <!-- IsChecked reads the model once; the write goes through the
                                                                         handler, which recompiles the snapshot and persists. A
                                                                         TwoWay binding could not do that on a non-observable
                                                                         persistence model. -->
                                                                    <CheckBox Grid.Column="0"
                                                                              MinWidth="0"
                                                                              Margin="0,0,6,0"
                                                                              IsChecked="{Binding Enabled, Mode=OneWay}"
                                                                              Tag="{Binding}"
                                                                              Click="ToggleHighlightRule_Click"
                                                                              ToolTipService.ToolTip="启用 / 停用此规则" />
                                                                    <Border Grid.Column="1"
                                                                            Width="12"
                                                                            Height="12"
                                                                            Margin="0,0,8,0"
                                                                            VerticalAlignment="Center"
                                                                            CornerRadius="3"
                                                                            Background="{Binding RenderedColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
                                                                    <TextBlock Grid.Column="2"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Text="{Binding Pattern}"
                                                                               ToolTipService.ToolTip="{Binding Pattern}" />
                                                                    <Button Grid.Column="3"
                                                                            Style="{StaticResource AppToolbarIconButtonStyle}"
                                                                            Content="&#xE74D;"
                                                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                            FontSize="12"
                                                                            Tag="{Binding}"
                                                                            Click="DeleteHighlightRule_Click"
                                                                            ToolTipService.ToolTip="删除此规则" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <Border Style="{StaticResource AppVerticalDividerStyle}" />

                                                <Button Style="{StaticResource AppToolbarButtonStyle}"
                                                        HorizontalAlignment="Stretch"
                                                        Content="添加高亮规则…"
                                                        Click="AddHighlightRule_Click"
                                                        ToolTipService.ToolTip="指定匹配内容与颜色" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <!-- Regex diagnostics sit next to the box they describe -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <FontIcon x:Name="RegexErrorIcon"
                                          Glyph="&#xE7BA;"
                                          FontSize="12"
                                          Foreground="{ThemeResource AppErrorTextBrush}"
                                          Visibility="Collapsed" />
                                <TextBlock x:Name="RegexErrorTextBlock"
                                           Foreground="{ThemeResource AppErrorTextBrush}"
                                           FontSize="12"
                                           MaxWidth="320"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="MatchCountTextBlock"
                                           Style="{StaticResource AppCaptionTextStyle}"
                                           FontFamily="{StaticResource AppMonoFontFamily}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Log actions. The four icon buttons share one capsule so they read as a
                                 single cluster of related actions; 暂停 stays a labelled button outside
                                 it, because it is a mode rather than another one-shot action, and a
                                 toggle that changes what the log does needs its word. The vertical rule
                                 that used to separate them is gone with the capsule. -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <Border Style="{StaticResource AppSegmentedGroupStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Style="{StaticResource AppToolbarIconButtonStyle}"
                                                Click="SelectAllLogs_Click"
                                                ToolTipService.ToolTip="全选日志 (Ctrl+A)">
                                            <FontIcon Glyph="&#xE8B3;" FontSize="13" />
                                        </Button>
                                        <Button Style="{StaticResource AppToolbarIconButtonStyle}"
                                                Click="CopySelectedLogs_Click"
                                                ToolTipService.ToolTip="复制选中日志 (Ctrl+C)">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        </Button>
                                        <!-- Sits with select/copy rather than with 清空: all three are "get the
                                             log out of here", and the export honours the selection the other
                                             two operate on. -->
                                        <Button Style="{StaticResource AppToolbarIconButtonStyle}"
                                                Click="ExportLogs_Click"
                                                ToolTipService.ToolTip="导出日志到文件（有选中行时只导出选中行）">
                                            <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                        </Button>
                                        <Button Style="{StaticResource AppToolbarIconButtonStyle}"
                                                Command="{x:Bind ViewModel.ClearLogsCommand}"
                                                ToolTipService.ToolTip="清空所有日志记录">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource AppToolbarButtonStyle}"
                                        Click="TogglePause_Click"
                                        ToolTipService.ToolTip="暂停时停止刷新 UI，文件日志继续记录">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Grid>
                                            <FontIcon Glyph="&#xE769;"
                                                      FontSize="13"
                                                      Visibility="{Binding IsPaused, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <FontIcon Glyph="&#xE768;"
                                                      FontSize="13"
                                                      Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: tuning payload + protocol. Hidden by default — the whole row is
                             collapsed until 工具 → 启用 Tuning 功能 is ticked, so an Auto row simply
                             collapses to zero height and leaves the toolbar single-line. -->
                        <Grid Grid.Row="1"
                              Margin="0,8,0,0"
                              Visibility="{Binding IsTuningEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0">
                                <FontIcon Glyph="&#xE950;"
                                          FontSize="13"
                                          Foreground="{ThemeResource AppAccentBrush}" />
                                <TextBlock Text="TUNING"
                                           Style="{StaticResource AppSectionLabelStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- File slots: a chip shows the file name, the full path is the tooltip.
                                 Placeholder and value are two TextBlocks rather than a converter. -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource AppToolbarButtonStyle}"
                                    Padding="9,0"
                                    MinWidth="0"
                                    HorizontalAlignment="Left"
                                    Click="SelectTuningBin_Click"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.TuningBinFilePath, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="13" />
                                    <TextBlock Text="未选择 bin 文件"
                                               Foreground="{ThemeResource AppTextTertiaryBrush}"
                                               Visibility="{Binding HasTuningBinFilePath, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.TuningBinDisplay, Mode=OneWay}"
                                               Visibility="{Binding HasTuningBinFilePath, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Style="{StaticResource AppToolbarButtonStyle}"
                                    Padding="9,0"
                                    MinWidth="0"
                                    Margin="6,0,0,0"
                                    HorizontalAlignment="Left"
                                    Click="SelectTuningDescriptor_Click"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.TuningDescriptorFilePath, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="13" />
                                    <TextBlock Text="未选择协议 JSON"
                                               Foreground="{ThemeResource AppTextTertiaryBrush}"
                                               Visibility="{Binding HasTuningDescriptorPath, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.TuningDescriptorDisplay, Mode=OneWay}"
                                               Visibility="{Binding HasTuningDescriptorPath, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind ViewModel.TuningStatus, Mode=OneWay}"
                                       Style="{StaticResource AppCaptionTextStyle}"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.TuningStatus, Mode=OneWay}" />

                            <StackPanel Grid.Column="4"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource AppToolbarButtonStyle}"
                                        Content="重载 JSON"
                                        Command="{x:Bind ViewModel.ReloadTuningDescriptorCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasTuningDescriptorPath, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.TuningDescriptorStatus, Mode=OneWay}" />
                                <Button Style="{StaticResource AppToolbarButtonStyle}"
                                        Content="{x:Bind ViewModel.TuningWatchButtonText, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.ToggleTuningWatchCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanUseTuning, Mode=OneWay}" />
                                <Button Style="{StaticResource AccentButtonStyle}"
                                        MinHeight="{StaticResource AppControlHeightCompact}"
                                        MinWidth="0"
                                        Padding="12,0"
                                        Command="{x:Bind ViewModel.SendCurrentTuningCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanUseTuning, Mode=OneWay}"
                                        ToolTipService.ToolTip="手动打包并发送当前 tuning bin">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE724;" FontSize="13" />
                                        <TextBlock Text="发送 Tuning" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========== Channel legend (signature) ==========
                     The colour-to-port mapping, stated explicitly: every colour visible in the log
                     body can be translated back to a physical port without opening the sidebar. -->
                <Border Grid.Row="2"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppHairlineBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,6"
                        Visibility="{Binding HasOpenPorts, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.OpenPorts, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Spacing is what separates the entries now that each one is a
                                         capsule: 14 px between bare text runs read as one line, 8 px
                                         between chips reads as a row of values. -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- One chip per port: colour bar, name, byte counters. The bar stays
                                         a 3 px trace so a legend chip and a log row still identify a port
                                         the same way. -->
                                    <Border Style="{StaticResource AppChipStyle}" Padding="8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Rectangle Width="3"
                                                       Height="14"
                                                       RadiusX="1.5"
                                                       RadiusY="1.5"
                                                       Fill="{Binding DisplayColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
                                            <TextBlock Text="{Binding PortName}"
                                                       FontFamily="{StaticResource AppMonoFontFamily}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatisticsDisplay, Mode=OneWay}"
                                                       FontFamily="{StaticResource AppMonoFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Logs Display - extracted into a UserControl so the DataTemplate can use compiled
                     x:Bind (Window-rooted DataTemplates can't, which is what was bottlenecking
                     wheel-scroll item realization). -->
                <!-- IsPinnedToBottom is TwoWay: the view decides it from the scroll position, and the
                     ViewModel reads it to hold off trimming the head of the buffer while the user is
                     reading history. -->
                <!-- The log surface and its empty state share one cell. The empty state is
                     IsHitTestVisible=False deliberately: it floats over the ListView, and the list's
                     wheel interception and selection handling must stay reachable underneath it. -->
                <Grid Grid.Row="3">
                    <controls:LogListView x:Name="LogListView"
                                          ItemsSource="{x:Bind ViewModel.DisplayLogs, Mode=OneWay}"
                                          IsPaused="{x:Bind ViewModel.IsPaused, Mode=OneWay}"
                                          IsPinnedToBottom="{x:Bind ViewModel.IsLogPinnedToBottom, Mode=TwoWay}"
                                          HighlightMatcher="{x:Bind ViewModel.HighlightMatcher, Mode=OneWay}"
                                          IsHighlightSuppressed="{x:Bind ViewModel.IsHighlightSuppressed, Mode=OneWay}"
                                          FontSize="{x:Bind ViewModel.LogFontSize, Mode=OneWay}"
                                          CopyCompleted="LogListView_CopyCompleted"
                                          CopyFailed="LogListView_CopyFailed"
                                          FontSizeZoomRequested="LogListView_FontSizeZoomRequested" />

                    <!-- Uses {Binding}, not {x:Bind}: a compiled binding with a Converter cannot be
                         used in the window's own element tree (a Window is not a FrameworkElement,
                         so the generated code has no converter-lookup root). -->
                    <!-- One of the three surfaces that genuinely float over data, so it is one of the
                         three that references the shared shadow (see AppCardStyle's note). -->
                    <Border x:Name="LogEmptyStateCard"
                            Style="{StaticResource AppCardStyle}"
                            MaxWidth="380"
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Shadow="{StaticResource AppOverlayShadow}"
                            Translation="0,0,32"
                            Visibility="{Binding HasOpenPorts, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE8E5;"
                                      FontSize="24"
                                      Foreground="{ThemeResource AppTextTertiaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="尚未打开串口"
                                       Style="{StaticResource AppEmptyStateTitleStyle}" />
                            <TextBlock Style="{StaticResource AppEmptyStateBodyStyle}"
                                       Text="从左侧「可用串口」中选择一个并打开，或点「全部打开」一次打开全部。多个串口可以同时监视，日志按端口颜色区分归属。" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========== Send ========== -->
                <Border Grid.Row="4"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppHairlineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Only the box is `*` — the same rule the search row above follows, so a
                                 narrow window shrinks the box and never pushes a button off the edge. The
                                 options that used to occupy this row as one ~900 px strip of checkboxes
                                 and combo boxes are exactly why the box used to collapse to zero width and
                                 发送 used to be clipped out of the window. -->
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Send options, folded into a flyout. Every switch behind this button is set once
                             and then left alone, yet together they decided how much room the send box got.
                             The button stays on the row so a non-default state is always one click away —
                             and the flyout scrolls, because 行间隔 lives at its bottom and a short window
                             must still be able to reach it. -->
                        <Button Grid.Column="0"
                                Style="{StaticResource AppToolbarButtonStyle}"
                                MinHeight="{StaticResource AppControlHeightPrimary}"
                                Padding="11,0"
                                Margin="0,0,8,0"
                                ToolTipService.ToolTip="发送选项：十六进制、发送回显、TX 颜色、行尾符、多行拆分与行间隔">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE713;" FontSize="13" />
                                <TextBlock Text="发送设置" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="SendSettingsFlyout" Placement="Top">
                                    <ScrollViewer MaxHeight="420"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Width="300" Spacing="10">
                                            <TextBlock Text="发送选项" Style="{StaticResource AppSectionLabelStyle}" />

                                            <!-- Two inset groups rather than eight stacked controls: the
                                                 panel answers two separate questions — how the payload is
                                                 interpreted, and what goes on the wire around it — and a
                                                 reader looking for one of them should not have to scan past
                                                 the other. -->
                                            <Border Style="{StaticResource AppInsetGroupStyle}">
                                                <StackPanel Spacing="8">
                                                    <CheckBox Content="十六进制发送"
                                                              IsChecked="{x:Bind ViewModel.SendAsHex, Mode=TwoWay}" />
                                                    <CheckBox Content="显示发送数据"
                                                              IsChecked="{x:Bind ViewModel.ShowSentData, Mode=TwoWay}" />

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="TX 颜色"
                                                                   Style="{StaticResource AppCaptionTextStyle}"
                                                                   FontFamily="{StaticResource AppMonoFontFamily}"
                                                                   ToolTipService.ToolTip="发送行的颜色。接收行颜色在左侧已打开串口列表中设置。" />
                                                        <ComboBox x:Name="TxColorComboBox"
                                                                  ItemsSource="{x:Bind ViewModel.TxColorOptions}"
                                                                  SelectedValuePath="Hex"
                                                                  SelectedValue="{x:Bind ViewModel.TxColorHex, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                                        <Rectangle Width="13"
                                                                                   Height="13"
                                                                                   RadiusX="3"
                                                                                   RadiusY="3"
                                                                                   Fill="{Binding Brush}"
                                                                                   VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource AppInsetGroupStyle}">
                                                <StackPanel Spacing="4">
                                                    <!-- The send box is single-line, so a device that expects \r could
                                                         previously only be driven through a snippet carrying an escape.
                                                         无 is the default and keeps the byte stream identical to
                                                         what it was before this existed. -->
                                                    <TextBlock Text="行尾"
                                                               Style="{StaticResource AppCaptionTextStyle}" />
                                                    <ComboBox ItemsSource="{x:Bind ViewModel.SendTerminatorOptions}"
                                                              SelectedValuePath="Value"
                                                              SelectedValue="{Binding SendTerminator, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch"
                                                              ToolTipService.ToolTip="发送文本时自动追加的行尾符。默认「无」，即发送框里的内容原样发出；串口设备通常需要 CR。">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <!-- Only meaningful once a terminator is selected, hence the
                                                         gate: with 无 the split would be a no-op, and a switch that
                                                         does nothing is worse than a greyed-out one. -->
                                                    <CheckBox Content="多行拆分"
                                                              Margin="0,4,0,0"
                                                              IsChecked="{x:Bind ViewModel.SplitMultilineSend, Mode=TwoWay}"
                                                              IsEnabled="{x:Bind ViewModel.CanSplitMultilineSend, Mode=OneWay}"
                                                              ToolTipService.ToolTip="勾选并选中行尾符后，输入里的换行会逐行发送（每行各带一个行尾符）；不勾选则整段内容末尾只加一个行尾符" />

                                                    <!-- Line interval (F7). Zero is the default and means one
                                                         write, byte-for-byte what this app has always sent; anything
                                                         above it inserts that many ms between lines. Text rather
                                                         than NumberBox so a half-typed value is left alone instead
                                                         of being rewritten under the caret. -->
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="6"
                                                                Margin="0,4,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="行间隔"
                                                                   Style="{StaticResource AppCaptionTextStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Text="{x:Bind ViewModel.SendLineDelayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 MinWidth="{StaticResource AppControlHeightCompact}"
                                                                 Width="72"
                                                                 MinHeight="{StaticResource AppControlHeightCompact}"
                                                                 InputScope="Number"
                                                                 IsEnabled="{x:Bind ViewModel.CanSplitMultilineSend, Mode=OneWay}"
                                                                 ToolTipService.ToolTip="多行发送时行与行之间等待的毫秒数。0 = 整段一次发出（默认，字节与改动前完全一致）；仅在选择行尾符并勾选多行拆分后生效">
                                                            <TextBox.Resources>
                                                                <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
                                                            </TextBox.Resources>
                                                        </TextBox>
                                                        <TextBlock Text="ms"
                                                                   Style="{StaticResource AppCaptionTextStyle}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- MinWidth rather than a fixed width: the box absorbs every width change the
                             row has to give (it is the `*` column) and this is the floor below which it
                             stops being an input field. Everything to its left and right is Auto, so the
                             floor is reached by the buttons staying put — not by pushing them out. -->
                        <TextBox x:Name="SendTextBox"
                                 Grid.Column="1"
                                 MinWidth="140"
                                 Text="{x:Bind ViewModel.SendText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="输入要发送的数据，回车发送…"
                                 KeyDown="SendTextBox_KeyDown"
                                 VerticalAlignment="Center"
                                 MinHeight="{StaticResource AppControlHeightPrimary}" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="8,0,0,0">
                            <!-- Quick-send library. A Button carrying a Flyout opens it on click, which is
                                 the whole interaction: pick a saved payload and it is broadcast to every
                                 open port through the same path as the send box.

                                 Icon-only since the settings moved out of this row: the icon cluster is the
                                 shape the log toolbar already uses, and it buys the send box back the width
                                 the words used to cost. The tooltip is the label. -->
                            <Button Style="{StaticResource AppToolbarIconButtonStyle}"
                                    MinHeight="{StaticResource AppControlHeightPrimary}"
                                    Padding="8"
                                    ToolTipService.ToolTip="快捷指令：保存常用内容并一键发送">
                                <FontIcon Glyph="&#xE950;" FontSize="14" />
                                <Button.Flyout>
                                    <Flyout x:Name="QuickSendFlyout" Placement="Top">
                                        <StackPanel Width="340" Spacing="8">
                                            <TextBlock Text="快捷指令"
                                                       Style="{StaticResource AppSectionLabelStyle}" />

                                            <!-- {Binding} rather than {x:Bind}: the visibility depends on a
                                                 converter, exactly like the search-history flyout's empty
                                                 state. -->
                                            <TextBlock Text="还没有保存的指令。在发送框里输入内容后，点下面的按钮保存。"
                                                       Style="{StaticResource AppEmptyStateBodyStyle}"
                                                       Visibility="{Binding HasSnippets, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                            <ScrollViewer MaxHeight="280"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <!-- Outer list uses {x:Bind} (the window is the binding root,
                                                     same as the search-history list); the nested templates
                                                     use {Binding} because their DataContext is the item. -->
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.SnippetGroups, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,6">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Style="{StaticResource AppSectionLabelStyle}"
                                                                           Margin="0,2,0,4" />
                                                                <ItemsControl ItemsSource="{Binding Items}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,1">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Button Grid.Column="0"
                                                                                        Style="{StaticResource AppHistoryItemButtonStyle}"
                                                                                        HorizontalAlignment="Stretch"
                                                                                        Content="{Binding Label}"
                                                                                        Tag="{Binding}"
                                                                                        Click="SendSnippet_Click"
                                                                                        ToolTipService.ToolTip="{Binding Content}" />
                                                                                <Button Grid.Column="1"
                                                                                        Style="{StaticResource AppToolbarIconButtonStyle}"
                                                                                        Content="&#xE74D;"
                                                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                                        FontSize="12"
                                                                                        Tag="{Binding}"
                                                                                        Click="DeleteSnippet_Click"
                                                                                        ToolTipService.ToolTip="删除此快捷指令" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <Border Style="{StaticResource AppVerticalDividerStyle}" />

                                            <Button Style="{StaticResource AppToolbarButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Content="保存发送框内容为快捷指令…"
                                                    Click="AddSnippet_Click"
                                                    ToolTipService.ToolTip="填写名称与分组后保存" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Send history panel (F8). Overlaid, and read-only over the same list the
                                 ↑/↓ keys recall from — it does not replace that recall. -->
                            <Button Style="{StaticResource AppToolbarIconButtonStyle}"
                                    MinHeight="{StaticResource AppControlHeightPrimary}"
                                    Padding="8"
                                    Click="OpenSendHistory_Click"
                                    ToolTipService.ToolTip="发送历史：查看、搜索并挑选之前发送过的内容（也可用 ↑/↓ 逐条召回）">
                                <FontIcon Glyph="&#xE81C;" FontSize="13" />
                            </Button>

                            <!-- 发送目标。文字始终可见，因为这个功能最容易出的错就是"以为在广播、其实只发
                                了一个口"。菜单项在 SendTargetFlyout_Opening 里动态构建——MenuFlyout 没有
                                ItemsSource，与端口颜色菜单同一个形状。 -->
                            <Button Style="{StaticResource AppToolbarButtonStyle}"
                                    MinHeight="{StaticResource AppControlHeightPrimary}"
                                    Padding="9,0"
                                    ToolTipService.ToolTip="选择本次发送的目标串口。默认「全部」；Tuning 推送不受此设置影响，仍广播到所有已打开串口。">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                                    <TextBlock Text="{x:Bind ViewModel.SendTargetDisplay, Mode=OneWay}" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="SendTargetFlyout"
                                                Placement="Top"
                                                Opening="SendTargetFlyout_Opening" />
                                </Button.Flyout>
                            </Button>

                            <Button Style="{StaticResource AccentButtonStyle}"
                                    MinHeight="{StaticResource AppControlHeightPrimary}"
                                    MinWidth="92"
                                    Click="SendButton_Click"
                                    ToolTipService.ToolTip="发送到全部已打开串口">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE724;" FontSize="13" />
                                    <TextBlock Text="发送" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ========== Status bar ==========
                     Chips, not a run of text separated by rules (v2.5.2): every entry here is one
                     value, and the fill says where it starts and ends. The status message is the only
                     free-form text on the bar and it keeps whatever width is left. -->
                <Border Grid.Row="5"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppHairlineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource AppChipStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6"
                                         Height="6"
                                         VerticalAlignment="Center"
                                         Fill="{ThemeResource AppOkBrush}"
                                         Visibility="{Binding HasOpenPorts, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Ellipse Width="6"
                                         Height="6"
                                         VerticalAlignment="Center"
                                         Fill="{ThemeResource AppTextTertiaryBrush}"
                                         Visibility="{Binding HasOpenPorts, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind ViewModel.OpenPortCountDisplay, Mode=OneWay}"
                                           Style="{StaticResource AppChipTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource AppChipStyle}"
                                Margin="8,0,0,0"
                                ToolTipService.ToolTip="全部已打开串口的累计接收 / 发送字节数">
                            <TextBlock Text="{x:Bind ViewModel.TotalTrafficDisplay, Mode=OneWay}"
                                       Style="{StaticResource AppChipTextStyle}" />
                        </Border>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.MatchCountDisplay, Mode=OneWay}"
                                       FontFamily="{StaticResource AppMonoFontFamily}"
                                       FontSize="11"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Style="{StaticResource AppCaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource AppChipStyle}">
                                <TextBlock Text="{x:Bind ViewModel.AppearanceDisplay, Mode=OneWay}"
                                           Style="{StaticResource AppChipTextStyle}"
                                           FontFamily="{StaticResource AppUiFontFamily}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.VersionDisplay, Mode=OneWay}"
                                       Style="{StaticResource AppCaptionTextStyle}"
                                       FontFamily="{StaticResource AppMonoFontFamily}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===================== Notification host =====================
             Bottom-right, over both rows. InfoBar rather than a bespoke popup: it already carries the
             severity icon, the accent stripe, the close button and the themed surface through the
             lightweight-styling keys in Themes/Tokens.xaml, so there is no second design to keep in
             sync. The ItemsControl has no background of its own, so only the bars take hit-testing —
             wheel and clicks pass through the empty space to the log list underneath. -->
        <ItemsControl x:Name="NotificationHost"
                      Grid.Row="0"
                      Grid.RowSpan="2"
                      ItemsSource="{Binding Notifications}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,20,20"
                      MaxWidth="380">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Severity binds straight through: the model carries InfoBarSeverity, so no
                         converter (and no per-item conversion) is involved. -->
                    <InfoBar IsOpen="{Binding IsOpen, Mode=TwoWay}"
                             IsClosable="True"
                             Severity="{Binding Severity}"
                             Title="{Binding Title}"
                             Message="{Binding Message}"
                             Margin="0,6,0,0" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- ============================= Command palette (F2) =============================
             Last child of the root grid and spanning both rows (title bar + body), so it covers the whole
             window without the shell reserving space for it: Collapsed until F2, no layout contribution
             while hidden, and nothing underneath needed a scrim hook. F2 rather than an accelerator —
             see the note on OnRootKeyDown above. -->
        <controls:QuickCommandPalette x:Name="CommandPalette"
                                      Grid.Row="0"
                                      Grid.RowSpan="2"
                                      Snippets="{x:Bind ViewModel.AllSnippets, Mode=OneWay}"
                                      OpenPorts="{x:Bind ViewModel.OpenPorts, Mode=OneWay}"
                                      AvailablePorts="{x:Bind ViewModel.AvailablePorts, Mode=OneWay}"
                                      Activated="CommandPalette_Activated" />

        <!-- ============================= Send history panel (F8) =============================
             Same overlay placement as the palette: last child, spanning both rows, Collapsed until opened,
             no layout contribution while hidden. It reads the ViewModel's one send-history collection, the
             same one the ↑/↓ keys recall from — see the control's own remarks for why it must not have a
             list of its own. -->
        <controls:SendHistoryPanel x:Name="HistoryPanel"
                                   Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Entries="{x:Bind ViewModel.SendHistoryEntries, Mode=OneWay}"
                                   Activated="HistoryPanel_Activated"
                                   Deleted="HistoryPanel_EntryDeleted"
                                   ClearRequested="HistoryPanel_ClearRequested" />

    </Grid>
</Window>
