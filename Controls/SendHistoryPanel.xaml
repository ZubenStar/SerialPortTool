<UserControl
    x:Class="SerialPortTool.Controls.SendHistoryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- A UserControl so the row template can use compiled x:Bind — the window's own tree cannot, a Window
         is not a FrameworkElement and has no converter-lookup root. Same reason QuickCommandPalette exists
         in this folder rather than being markup inline in MainWindow. -->
    <UserControl.Resources>
        <!-- Duplicated from the palette rather than shared: both are the app's only translucent surface and
             App.xaml deliberately holds only converters. Changing one without the other would make two
             "press F2 / 历史" surfaces differ in dimness for no reason. -->
        <SolidColorBrush x:Key="HistoryScrimBrush" Color="#73101317" />

        <DataTemplate x:Key="SendHistoryRowTemplate" x:DataType="x:String">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind}"
                           FontFamily="{StaticResource AppMonoFontFamily}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <!-- Tag carries the row itself: a history entry IS its payload, so there is no id to look up.
                     Deleting is per-entry by design — clearing the whole list sits in the footer, where a
                     destructive action belongs. -->
                <Button Grid.Column="1"
                        Style="{StaticResource AppToolbarIconButtonStyle}"
                        Content="&#xE74D;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="12"
                        Tag="{x:Bind}"
                        Click="DeleteRow_Click"
                        ToolTipService.ToolTip="删除这一条" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Scrim and card are siblings, not nested, so a tap on the card never reaches the dismiss handler. -->
    <Grid x:Name="Overlay" Visibility="Collapsed">
        <Grid x:Name="Scrim" Background="{StaticResource HistoryScrimBrush}" Tapped="Scrim_Tapped" />

        <Border Style="{StaticResource AppCardStyle}"
                Width="560"
                MaxHeight="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,88,0,0"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="QueryBox"
                         Grid.Row="0"
                         Margin="12,12,12,8"
                         MinHeight="{StaticResource AppControlHeightPrimary}"
                         PlaceholderText="搜索之前发送过的内容…"
                         TextChanged="QueryBox_TextChanged"
                         KeyDown="QueryBox_KeyDown" />

                <Border Grid.Row="1" Style="{StaticResource AppVerticalDividerStyle}" />

                <ListView x:Name="ResultList"
                          Grid.Row="2"
                          MaxHeight="300"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="ResultList_ItemClick"
                          ItemTemplate="{StaticResource SendHistoryRowTemplate}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <TextBlock x:Name="EmptyHint"
                           Grid.Row="2"
                           Text="没有匹配的发送记录"
                           Style="{StaticResource AppEmptyStateBodyStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,28"
                           Visibility="Collapsed" />

                <Border Grid.Row="3" Style="{StaticResource AppVerticalDividerStyle}" />

                <Grid Grid.Row="4" Margin="12,8,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="↑↓ 选择 · Enter 填入发送框 · Esc 关闭"
                               Style="{StaticResource AppCaptionTextStyle}"
                               Foreground="{ThemeResource AppTextTertiaryBrush}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Style="{StaticResource AppToolbarButtonStyle}"
                            MinHeight="{StaticResource AppControlHeightCompact}"
                            Padding="9,0"
                            Click="ClearAll_Click"
                            ToolTipService.ToolTip="清空全部发送历史">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                            <TextBlock Text="清空历史" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
