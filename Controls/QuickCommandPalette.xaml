<UserControl
    x:Class="SerialPortTool.Controls.QuickCommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SerialPortTool.Models"
    mc:Ignorable="d">

    <!-- A UserControl so the DataTemplate can use compiled x:Bind, exactly like LogListView: the
         window's own tree cannot (a Window is not a FrameworkElement, so a compiled binding has no
         converter-lookup root there). -->
    <UserControl.Resources>
        <!-- Dim veil behind the card. A literal rather than a token, deliberately: this is the only
             translucent surface in the app (every named brush in Tokens.xaml is opaque by design), and
             alpha over the graphite background reads correctly on all three palettes — a light veil
             would wash out the sunken log surface in dark mode. -->
        <SolidColorBrush x:Key="PaletteScrimBrush" Color="#730F1219" />

        <DataTemplate x:Key="PaletteEntryTemplate" x:DataType="models:PaletteEntry">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- For a port this is the same 3px channel trace the log rows carry, so a port reads as
                     the same thing here as it does there. Snippets leave it empty, and a zero-width
                     border costs nothing. -->
                <Border Grid.Column="0"
                        Width="3"
                        CornerRadius="1.5"
                        Background="{x:Bind AccentHex, Converter={StaticResource HexColorToBrushConverter}}" />

                <FontIcon Grid.Column="1"
                          Glyph="{x:Bind Glyph}"
                          FontSize="13" />

                <TextBlock Grid.Column="2"
                           Text="{x:Bind Title}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="3"
                           Text="{x:Bind Subtitle}"
                           FontSize="11"
                           Foreground="{ThemeResource AppTextTertiaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- The dismiss layer and the card are SIBLINGS, not nested. Taps on the card therefore never reach
         the dismiss handler, which is why no Tapped handler needs to mark anything Handled — and why the
         result list keeps its own click handling intact. -->
    <Grid x:Name="Overlay" Visibility="Collapsed">
        <Grid x:Name="Scrim" Background="{StaticResource PaletteScrimBrush}" Tapped="Scrim_Tapped" />

        <!-- No shadow: the dimmed scrim behind the card is what makes it float, and a ThemeShadow
             would cost the text inside it its ClearType rendering (a shadow needs a Z translation,
             and a non-zero Z composites the subtree) — see AppCardStyle's note in
             Themes/Controls.xaml. Separation from the log behind comes from the scrim and the card's
             own border. -->
        <Border Style="{StaticResource AppCardStyle}"
                Width="560"
                MaxHeight="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,88,0,0"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="QueryBox"
                         Grid.Row="0"
                         Margin="12,12,12,8"
                         MinHeight="{StaticResource AppControlHeightPrimary}"
                         PlaceholderText="搜索串口或快捷指令…"
                         TextChanged="QueryBox_TextChanged"
                         KeyDown="QueryBox_KeyDown" />

                <Border Grid.Row="1" Style="{StaticResource AppVerticalDividerStyle}" />

                <!-- IsItemClickEnabled: one click runs the row, the same as Enter. SelectionMode=Single
                     keeps the keyboard cursor visible while arrowing through results. -->
                <ListView x:Name="ResultList"
                          Grid.Row="2"
                          MaxHeight="300"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="ResultList_ItemClick"
                          ItemTemplate="{StaticResource PaletteEntryTemplate}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!-- Compact rows: 14 rows in a 300px list is the point of a palette. -->
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Shares the row with the list. When there are results the list has height and this is
                     collapsed; when there are none the list measures to zero and this is all that shows. -->
                <TextBlock x:Name="EmptyHint"
                           Grid.Row="2"
                           Text="没有匹配的串口或指令"
                           Style="{StaticResource AppEmptyStateBodyStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,28"
                           Visibility="Collapsed" />

                <Border Grid.Row="3" Style="{StaticResource AppVerticalDividerStyle}" />

                <TextBlock Grid.Row="4"
                           Margin="12,8,12,10"
                           Text="↑↓ 选择 · Enter 执行 · Esc 关闭"
                           Style="{StaticResource AppCaptionTextStyle}"
                           Foreground="{ThemeResource AppTextTertiaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
