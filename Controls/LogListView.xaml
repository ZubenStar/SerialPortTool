<UserControl
    x:Class="SerialPortTool.Controls.LogListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SerialPortTool.Models"
    mc:Ignorable="d">

    <!-- Hosting the log ListView inside a UserControl (a FrameworkElement) instead of directly
         under MainWindow (a Window, which is NOT a FrameworkElement in WinUI 3) lets us use x:Bind
         in the DataTemplate. Compiled bindings shave ~5-10x off per-item realization compared to
         reflection-based {Binding}, which is the dominant cost during wheel-scroll virtualization. -->

    <ListView x:Name="InnerListView"
              ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
              SelectionMode="Extended"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Padding="8,4"
              IsTabStop="True"
              ScrollViewer.HorizontalScrollMode="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              KeyDown="InnerListView_KeyDown">
        <ListView.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="复制选中 (Ctrl+C)" Click="CopySelected_Click"/>
                <MenuFlyoutItem Text="全选 (Ctrl+A)" Click="SelectAllInList_Click"/>
            </MenuFlyout>
        </ListView.ContextFlyout>
        <!-- Reduce off-screen item realization. Default CacheLength=1.0 realizes ~3x visible items. -->
        <ListView.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsStackPanel CacheLength="0.5"/>
            </ItemsPanelTemplate>
        </ListView.ItemsPanel>
        <!-- Disable item transitions: animations on add/recycle cause stutter while wheel-scrolling. -->
        <ListView.ItemContainerTransitions>
            <TransitionCollection/>
        </ListView.ItemContainerTransitions>
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <!-- Minimal template: only Normal/Selected states. PointerOver removed because
                                 wheel-scrolling parades items under a stationary cursor, triggering rapid
                                 state changes and per-item layout invalidation. -->
                            <Grid x:Name="Root"
                                  Background="Transparent"
                                  Padding="4,0">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="0"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
            <!-- x:Bind compiles bindings at build time — no per-item reflection or PropertyChanged
                 wiring. FormattedText and ColorHex are set once at LogEntry construction, so OneTime
                 is the right mode and the cheapest option. -->
            <DataTemplate x:DataType="models:LogEntry">
                <TextBlock Text="{x:Bind FormattedText}"
                           Foreground="{x:Bind ColorHex, Converter={StaticResource HexColorToBrushConverter}}"
                           FontFamily="Consolas"
                           FontSize="14"
                           TextWrapping="NoWrap"
                           IsTextSelectionEnabled="False"
                           Padding="0,1,0,1"/>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
