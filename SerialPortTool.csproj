<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SerialPortTool</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\Images\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Read version from version.json at evaluation time (must be before version assignment).

       \A anchors to the START OF THE DOCUMENT, which is the only anchor that identifies the top-level
       "version" key. Two weaker options were tried and both are wrong:
         * '"version"\s*:\s*"([^"]+)"' matches the first occurrence anywhere — a changelog entry.
         * '(?m)^\s*\{\s*"version"\s*:\s*"([^"]+)"' looks anchored, but ^ matches any line start and
           \s* spans newlines, so it also matches a nested '{' followed by a "version" key. The last
           changelog entry in this repo is written exactly that way, so a missing top-level key
           silently resolved to 1.0.0 and the build succeeded.
       The optional \uFEFF tolerates a BOM, which a PowerShell 5.1 "Set-Content -Encoding UTF8" would
       otherwise reintroduce. -->
  <PropertyGroup>
    <VersionJsonContent>$([System.IO.File]::ReadAllText('$(ProjectDir)version.json'))</VersionJsonContent>
    <VersionFromJson>$([System.Text.RegularExpressions.Regex]::Match($(VersionJsonContent), '\A\uFEFF?\s*\{\s*"version"\s*:\s*"([^"]+)"').Groups[1].Value)</VersionFromJson>
    <VersionIsWellFormed>$([System.Text.RegularExpressions.Regex]::IsMatch('$(VersionFromJson)', '^[0-9]+\.[0-9]+\.[0-9]+$'))</VersionIsWellFormed>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Version Information - read from version.json. There is deliberately NO hard-coded fallback:
         a stale fallback (it was 1.7.0 while the project was on 2.1.0) produces a silently
         mis-versioned build instead of a failed one. The ValidateVersion target below turns an
         unreadable version.json into a build error. -->
    <Version Condition="'$(VersionFromJson)' != ''">$(VersionFromJson)</Version>
    <AssemblyVersion Condition="'$(VersionFromJson)' != ''">$(VersionFromJson).0</AssemblyVersion>
    <FileVersion Condition="'$(VersionFromJson)' != ''">$(VersionFromJson).0</FileVersion>
    <InformationalVersion Condition="'$(VersionFromJson)' != ''">$(VersionFromJson)</InformationalVersion>
    
    <!-- Publishing Configuration -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    
    <!-- Disable single file bundling to avoid duplicate file issues -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeSymbolsInSingleFile>false</IncludeSymbolsInSingleFile>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Include version.json in project -->
    <None Include="version.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  
  <!-- Target to generate build timestamp at compile time -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <BuildInfoPath>$(MSBuildProjectDirectory)\Helpers\BuildInfo.g.cs</BuildInfoPath>
    </PropertyGroup>
    
    <!-- Generate BuildInfo.g.cs using PowerShell script -->
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\generate-buildinfo.ps1&quot; -OutputPath &quot;$(BuildInfoPath)&quot;" />
  </Target>
  
  <!-- Fail the build when version.json cannot be parsed, instead of shipping a mis-versioned build.
       Runs before BeforeBuild so nothing downstream (manifest sync, compile, installer) sees the
       empty version. -->
  <Target Name="ValidateVersion" BeforeTargets="BeforeBuild">
    <Error Condition="'$(VersionFromJson)' == ''"
           Text="Could not read the top-level 'version' value from '$(ProjectDir)version.json'. The file must start with { &quot;version&quot;: &quot;x.y.z&quot;, ... }." />
    <Error Condition="'$(VersionIsWellFormed)' != 'True'"
           Text="The 'version' value in version.json must be three numeric parts (e.g. 2.1.0); got '$(VersionFromJson)'." />
  </Target>

  <!-- Target to update Package.appxmanifest version before build -->
  <Target Name="UpdateManifestVersion" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <ManifestPath>$(MSBuildProjectDirectory)\Package.appxmanifest</ManifestPath>
    </PropertyGroup>
    <!-- Use PowerShell script to safely update only the Identity Version -->
    <Exec Condition="'$(VersionFromJson)' != ''" Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\update-manifest-version.ps1&quot; -ManifestPath &quot;$(ManifestPath)&quot; -Version &quot;$(VersionFromJson).0&quot;" />
    <Message Condition="'$(VersionFromJson)' != ''" Text="Updated Package.appxmanifest Identity version to $(VersionFromJson).0" Importance="high" />
    <Message Condition="'$(VersionFromJson)' == ''" Text="WARNING: VersionFromJson is empty, skipping manifest version update" Importance="high" />
  </Target>

  <!-- Target to prevent duplicate assemblies in publish output -->
  <Target Name="DeduplicateBundleFiles" BeforeTargets="GenerateBundle" Condition="'@(FilesToBundle)' != ''">
    <ItemGroup>
      <!-- Create a copy of all files to process -->
      <_AllBundleFiles Include="@(FilesToBundle)" />
      
      <!-- Clear the list -->
      <FilesToBundle Remove="@(FilesToBundle)" />
      
      <!-- Add back files, preferring absolute paths over relative ones -->
      <FilesToBundle Include="@(_AllBundleFiles)"
                     Condition="'%(_AllBundleFiles.BundleRelativePath)' != 'SerialPortTool.dll' or
                                ($([System.IO.Path]::IsPathRooted('%(_AllBundleFiles.SourcePath)')) and
                                 $([System.String]::Copy('%(_AllBundleFiles.SourcePath)').Contains('$(MSBuildProjectDirectory)')))" />
      
      <!-- Clean up temporary items -->
      <_AllBundleFiles Remove="@(_AllBundleFiles)" />
    </ItemGroup>
    <Message Text="Deduplicated bundle files for SerialPortTool.dll" Importance="high" />
  </Target>

  <ItemGroup>
    <!-- WinUI 3 鍜?MVVM -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    
    <!-- 涓插彛閫氫俊 -->
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    
    <!-- 鏃ュ織 -->
    <PackageReference Include="Serilog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    
    <!-- 渚濊禆娉ㄥ叆 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\**\*" />
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
