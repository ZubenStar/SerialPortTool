<Project Sdk="Microsoft.NET.Sdk">

  <!-- Logic-layer tests only: no UI, no XAML, no window. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The app is a WinExe; a test host must not inherit that. -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- The two dependencies the linked sources actually use. Pinned to the app's own versions so the
         linked code compiles against the same assemblies it ships with. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app project is deliberately NOT referenced. It is a WinUI 3 app, and a project reference
         pulls in the WindowsAppSDK's buildTransitive Appx/Pri targets, whose tasks live in Visual
         Studio's MSBuild tooling (Microsoft.Build.AppxPackage.dll) and are absent from the .NET SDK.
         The referencing project then fails to BUILD before a single test runs, via MSB4062 on
         RemovePayloadDuplicates — an *unguarded* target, so no property turns it off.
         AppxGeneratePriEnabled=false silences MrtCore.PriGen.targets:908 but only reveals the next one.
         (EnableMsixTooling=false, the advice usually given for test projects, affects neither.)

         So the sources under test are compiled directly instead. That is only possible because they
         really are UI-free, and it turns that claim into a build-time guarantee: if one of these files
         ever grows a dependency on Microsoft.UI.*, this project stops compiling — which is exactly the
         signal worth having, rather than a test suite that quietly needs a desktop session.

         Add a file here only if it is genuinely UI-free. Anything touching Microsoft.UI.Xaml.* belongs
         in the app and has to be verified by the manual checklist in AGENTS.md instead. -->
    <Compile Include="..\..\Services\ISettingsService.cs" Link="Linked\ISettingsService.cs" />
    <Compile Include="..\..\Services\IHighlightRuleService.cs" Link="Linked\IHighlightRuleService.cs" />
    <Compile Include="..\..\Services\HighlightRuleService.cs" Link="Linked\HighlightRuleService.cs" />
    <Compile Include="..\..\Services\ILogExportService.cs" Link="Linked\ILogExportService.cs" />
    <Compile Include="..\..\Services\LogExportService.cs" Link="Linked\LogExportService.cs" />
    <Compile Include="..\..\Models\HighlightRule.cs" Link="Linked\HighlightRule.cs" />
    <Compile Include="..\..\Models\LogEntry.cs" Link="Linked\LogEntry.cs" />
    <!-- Send-path planning and the two send-side stores. All pure logic: no service, no window, no
         Microsoft.UI.* — the same requirement every entry in this list has. -->
    <Compile Include="..\..\Core\Enums\SendLineEnding.cs" Link="Linked\SendLineEnding.cs" />
    <Compile Include="..\..\Helpers\SendLineEndings.cs" Link="Linked\SendLineEndings.cs" />
    <Compile Include="..\..\Helpers\SendHistory.cs" Link="Linked\SendHistory.cs" />
    <Compile Include="..\..\Helpers\SerialEncodings.cs" Link="Linked\SerialEncodings.cs" />
    <Compile Include="..\..\Helpers\PaletteSearchMatcher.cs" Link="Linked\PaletteSearchMatcher.cs" />
    <!-- Wildcard because the palette is a pair of files (the slot model and the palette itself) and the
         tests need both; one of them has to be allowed to be split further without touching this list. -->
    <Compile Include="..\..\Models\PortColor*.cs" Link="Linked\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
